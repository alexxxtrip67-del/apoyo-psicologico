---
// src/components/Sidebar.astro
---
<aside class="sidebar" style="width: 260px; min-width: 260px; background-color: #0b132b; border-right: 1px solid #1c2541; padding: 1.5rem 1rem; display: flex; flex-direction: column; justify-content: space-between; min-height: 100vh;">
  <div>
    <!-- Logo y título en el Sidebar -->
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem; padding: 0.5rem;">
      <div style="background: rgba(99, 102, 241, 0.2); padding: 0.5rem; border-radius: 0.75rem;">
        <i class="fa-solid fa-brain" style="color: #818cf8; font-size: 1.25rem;"></i>
      </div>
      <div>
        <h3 style="color: #ffffff; font-size: 1rem; font-weight: 700; margin: 0;">Apoyo Psicológico</h3>
        <p style="color: #94a3b8; font-size: 0.75rem; margin: 0;">Tu bienestar importa</p>
      </div>
    </div>

    <!-- Enlaces de navegación -->
    <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
      <a href="#" class="active" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #ffffff; background-color: #4f46e5; text-decoration: none; border-radius: 0.75rem; font-weight: 500;">
        <i class="fa-solid fa-house"></i> Inicio
      </a>
      <a href="#" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #94a3b8; text-decoration: none; border-radius: 0.75rem; font-weight: 500;">
        <i class="fa-solid fa-clipboard-list"></i> Cuestionario
      </a>
      <a href="#" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #94a3b8; text-decoration: none; border-radius: 0.75rem; font-weight: 500;">
        <i class="fa-solid fa-comments"></i> Chat con IA
      </a>
      <a href="#" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #94a3b8; text-decoration: none; border-radius: 0.75rem; font-weight: 500;">
        <i class="fa-solid fa-folder-open"></i> Mis reportes
      </a>
      <a href="#" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #94a3b8; text-decoration: none; border-radius: 0.75rem; font-weight: 500;">
        <i class="fa-solid fa-user"></i> Perfil
      </a>
    </nav>
  </div>

  <!-- Botón de cerrar sesión abajo -->
  <div>
    <button id="logout-btn" style="background: transparent; border: none; color: #94a3b8; display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; width: 100%; border-radius: 0.75rem; cursor: pointer; font-weight: 500; text-align: left;">
      <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
    </button>
  </div>
</aside>