---
// src/components/Header.astro
---
<header id="main-header" class="h-16 border-b border-slate-800 px-6 flex items-center justify-between bg-[#1c2541]/40 backdrop-blur-md sticky top-0 z-10">
  <div class="flex items-center space-x-3">
    <i class="fa-solid fa-magnifying-glass text-slate-400 text-sm"></i>
    <input type="text" placeholder="Buscar..." class="bg-transparent text-sm focus:outline-none text-slate-200 placeholder-slate-500 w-48 md:w-64" />
  </div>
  <div class="flex items-center space-x-4">
    <button class="text-slate-400 hover:text-white relative">
      <i class="fa-regular fa-bell text-lg"></i>
      <span class="absolute -top-1 -right-1 w-2 h-2 bg-indigo-500 rounded-full"></span>
    </button>
    <div class="flex items-center space-x-3 pl-4 border-l border-slate-800">
      <div id="user-avatar" class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-xs text-white">JP</div>
      <div class="hidden sm:block">
        <p id="user-name" class="text-xs font-semibold text-white leading-tight">Juan Pérez</p>
        <p id="user-role" class="text-[10px] text-indigo-300">Estudiante</p>
      </div>
    </div>
  </div>
</header>