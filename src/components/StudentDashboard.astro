---
// src/components/StudentDashboard.astro
---

<div class="dashboard-container">
  <!-- SECCIÓN 1: INICIO -->
  <div id="section-inicio" class="dashboard-section">
    <h1 id="welcome-title">Hola, Estudiante 👋</h1>
    <p style="color: #64748b;">Tu bienestar emocional es importante. Aquí tienes un resumen de tu progreso.</p>

    <!-- Banner "No estás solo" -->
    <div class="banner-assist" style="background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%); border: 1px solid #c7d2fe; border-radius: 1.25rem; padding: 2.25rem; margin: 1.5rem 0; color: #1e1b4b;">
      <h3>Asistencia Emocional</h3>
      <h2 style="font-size: 1.6rem; font-weight: 800; margin: 0.5rem 0;">No estás solo</h2>
      <p style="color: #4338ca; margin-bottom: 1.25rem;">Si necesitas hablar, puedes hacerlo con nuestro asistente de IA o agendar una cita directa con la psicóloga de la institución.</p>
      <div style="display: flex; gap: 1rem;">
        <button type="button" class="nav-trigger" data-target="chat" style="background: #4f46e5; color: #ffffff; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Ir al chat con IA &rarr;</button>
        <button type="button" class="nav-trigger" data-target="citas" style="background: #ffffff; color: #4f46e5; border: 1px solid #4f46e5; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Agendar con Psicóloga</button>
      </div>
    </div>

    <!-- Grilla de Tarjetas -->
    <div class="grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-top: 1.5rem;">
      <div style="background: #ffffff; padding: 1.75rem 1.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <div>
          <div style="color: #4f46e5; font-size: 1.25rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-heart-pulse"></i></div>
          <h3 style="font-size: 1.1rem; color: #0f172a; margin-bottom: 0.4rem;">Cuestionario emocional</h3>
          <p style="font-size: 0.85rem; color: #64748b;">Completa tu evaluación periódica.</p>
        </div>
        <button type="button" class="nav-trigger" data-target="cuestionario" style="background: #4f46e5; color: white; border: none; padding: 0.65rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; width: 100%;">Ir al cuestionario</button>
      </div>

      <div style="background: #ffffff; padding: 1.75rem 1.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <div>
          <div style="color: #4f46e5; font-size: 1.25rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-calendar-check"></i></div>
          <h3 style="font-size: 1.1rem; color: #0f172a; margin-bottom: 0.4rem;">Citas disponibles</h3>
          <p style="font-size: 0.85rem; color: #64748b;">Reserva tu horario con la psicóloga.</p>
        </div>
        <button type="button" class="nav-trigger" data-target="citas" style="background: #4f46e5; color: white; border: none; padding: 0.65rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; width: 100%;">Agendar cita</button>
      </div>

      <div style="background: #ffffff; padding: 1.75rem 1.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <div>
          <div style="color: #4f46e5; font-size: 1.25rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-folder-open"></i></div>
          <h3 style="font-size: 1.1rem; color: #0f172a; margin-bottom: 0.4rem;">Mis reportes</h3>
          <p style="font-size: 0.85rem; color: #64748b;">Revisa tu historial de respuestas.</p>
        </div>
        <button type="button" class="nav-trigger" data-target="reportes" style="background: #4f46e5; color: white; border: none; padding: 0.65rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; width: 100%;">Ver reportes</button>
      </div>

      <div style="background: #ffffff; padding: 1.75rem 1.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <div>
          <div style="color: #4f46e5; font-size: 1.25rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-robot"></i></div>
          <h3 style="font-size: 1.1rem; color: #0f172a; margin-bottom: 0.4rem;">Chat con IA</h3>
          <p style="font-size: 0.85rem; color: #64748b;">Habla con nuestro asistente cuando quieras.</p>
        </div>
        <button type="button" class="nav-trigger" data-target="chat" style="background: #4f46e5; color: white; border: none; padding: 0.65rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; width: 100%;">Abrir chat</button>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 2: CUESTIONARIO EMOCIONAL -->
  <div id="section-cuestionario" class="dashboard-section hidden">
    <h2>Cuestionario de bienestar emocional</h2>
    <p style="margin-bottom: 1.5rem; color: #64748b;">Responde con sinceridad. Esta evaluación consta de 10 preguntas para analizar tu estado emocional actual.</p>
    
    <div style="background: #ffffff; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div style="background: #e2e8f0; height: 10px; border-radius: 5px; flex: 1; margin-right: 1.5rem; overflow: hidden;">
          <div id="progress-fill" style="background: #4f46e5; height: 100%; width: 10%; transition: width 0.3s;"></div>
        </div>
        <span id="question-counter" style="font-size: 0.9rem; font-weight: 600; color: #64748b;">Pregunta 1 de 10</span>
      </div>

      <h3 id="question-title" style="font-size: 1.25rem; color: #0f172a; margin-bottom: 1.5rem;">Cargando pregunta...</h3>

      <div id="options-container" style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem;"></div>

      <div style="display: flex; justify-content: space-between;">
        <button type="button" id="prev-question" style="background: #ffffff; color: #4f46e5; border: 1px solid #4f46e5; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">&larr; Anterior</button>
        <button type="button" id="next-question" style="background: #4f46e5; color: #ffffff; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Siguiente &rarr;</button>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 3: CITAS LIBRES CON LA PSICÓLOGA -->
  <div id="section-citas" class="dashboard-section hidden">
    <h2>Agendamiento de Citas con Psicología</h2>
    <p style="margin-bottom: 1.5rem; color: #64748b;">Selecciona un horario disponible configurado por la psicóloga institucional para recibir atención personalizada.</p>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
      <div style="background: #ffffff; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <h3 style="font-size: 1.15rem; color: #0f172a; margin-bottom: 1.25rem;"><i class="fa-solid fa-clock" style="color: #4f46e5; margin-right: 0.5rem;"></i> Horarios Libres Disponibles</h3>
        <div id="slots-container" style="display: flex; flex-direction: column; gap: 0.85rem;"></div>
      </div>

      <div style="background: #ffffff; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <h3 style="font-size: 1.15rem; color: #0f172a; margin-bottom: 1.25rem;"><i class="fa-solid fa-calendar-check" style="color: #10b981; margin-right: 0.5rem;"></i> Tus Citas Reservadas</h3>
        <div id="my-appointments" style="display: flex; flex-direction: column; gap: 1rem;">
          <p style="color: #94a3b8; font-size: 0.875rem;">Aún no has reservado una cita este mes.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 4: CHAT CON IA -->
  <div id="section-chat" class="dashboard-section hidden">
    <h2>Chat con IA</h2>
    <p style="margin-bottom: 1.5rem; color: #64748b;">Aquí puedes hablar libremente. Estoy para escucharte.</p>

    <div style="background: #ffffff; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; height: 480px; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <div id="chat-messages" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; padding-right: 0.5rem; margin-bottom: 1rem;">
        <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
          <div style="background: #e0e7ff; color: #4f46e5; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;"><i class="fa-solid fa-robot"></i></div>
          <div style="background: #f1f5f9; padding: 1rem; border-radius: 1rem; max-width: 75%; color: #0f172a; font-size: 0.95rem;">
            Hola, soy tu asistente virtual. Estoy aquí para escucharte y apoyarte. Puedes contarme lo que sientes o preguntarme lo que necesites.
          </div>
        </div>
      </div>

      <form id="chat-form" style="display: flex; gap: 0.75rem; border-top: 1px solid #e2e8f0; padding-top: 1rem;">
        <input type="text" id="chat-input" placeholder="Escribe tu mensaje..." style="flex: 1; padding: 0.8rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none;" required />
        <button type="submit" style="background: #4f46e5; color: white; border: none; padding: 0.8rem 1.25rem; border-radius: 0.75rem; cursor: pointer;"><i class="fa-solid fa-paper-plane"></i></button>
      </form>
    </div>
  </div>

  <!-- SECCIÓN 5: MIS REPORTES -->
  <div id="section-reportes" class="dashboard-section hidden">
    <h2>Resultados de tu cuestionario</h2>
    <p style="margin-bottom: 1.5rem; color: #64748b;">Aquí puedes ver el análisis de tu última evaluación y recomendaciones personalizadas.</p>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
      <div style="background: #ffffff; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <div id="report-icon" style="font-size: 3rem; color: #10b981;"><i class="fa-solid fa-face-smile"></i></div>
        <div>
          <h3 id="report-status-title" style="font-size: 1.15rem; color: #0f172a; margin-bottom: 0.4rem;">Tu estado emocional se encuentra en un rango estable.</h3>
          <p id="report-status-desc" style="color: #64748b; font-size: 0.85rem;">Continúa con tus hábitos de autocuidado y mantén una comunicación abierta con tus seres queridos.</p>
        </div>
      </div>

      <div style="background: #ffffff; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
        <h3 style="font-size: 1.1rem; color: #0f172a; margin-bottom: 0.75rem;">Recomendaciones</h3>
        <ul id="report-recommendations" style="padding-left: 1.25rem; color: #64748b; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem;">
          <li>Mantén una buena rutina de sueño.</li>
          <li>Realiza actividades físicas o recreativas.</li>
          <li>Acude a agendar una cita si requieres desahogarte.</li>
        </ul>
      </div>
    </div>

    <h3 style="font-size: 1.25rem; color: #0f172a; margin-bottom: 1rem;">Historial de cuestionarios</h3>
    <div style="background: #ffffff; border-radius: 1.25rem; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc; color: #64748b; font-size: 0.85rem;">
            <th style="padding: 1rem 1.5rem;">Fecha</th>
            <th style="padding: 1rem 1.5rem;">Estado emocional</th>
            <th style="padding: 1rem 1.5rem; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody style="font-size: 0.9rem; color: #0f172a;">
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 1rem 1.5rem;" id="table-date-1">08/11/2026</td>
            <td style="padding: 1rem 1.5rem; color: #10b981; font-weight: 600;" id="table-status-1">Estable</td>
            <td style="padding: 1rem 1.5rem; text-align: right;"><button onclick="alert('Reporte generado tras completar el cuestionario.')" style="background: #f1f5f9; color: #4f46e5; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Ver detalles</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SECCIÓN 6: PERFIL CON FOTO REAL -->
  <div id="section-perfil" class="dashboard-section hidden">
    <h2>Mi perfil</h2>
    <p style="margin-bottom: 1.5rem; color: #64748b;">Administra tu información personal y sube tu foto de perfil real.</p>

    <div style="background: #ffffff; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; gap: 3rem; align-items: flex-start; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
        <div id="profile-avatar-large" style="width: 105px; height: 105px; background: #4f46e5; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; font-weight: bold; overflow: hidden; border: 3px solid #e0e7ff;">
          JP
        </div>
        <input type="file" id="photo-input" accept="image/*" style="display: none;" />
        <button type="button" id="change-photo-btn" style="background: #ffffff; color: #4f46e5; border: 1px solid #4f46e5; padding: 0.5rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Cambiar foto</button>
      </div>

      <form id="profile-form" style="flex: 1; display: flex; flex-direction: column; gap: 1.25rem;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.4rem;">Nombre completo</label>
          <input type="text" id="profile-name-input" value="Juan Pérez" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none;" />
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.4rem;">Correo electrónico</label>
          <input type="email" id="profile-email-input" value="juanperez@gmail.com" style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none;" />
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.4rem;">Rol</label>
          <select style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; background: white;">
            <option>Estudiante</option>
          </select>
        </div>
        <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
          <button type="submit" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // CORRECCIÓN DE CAMBIO DE SECCIONES SEGURO
  function switchDashboardSection(targetId: string) {
    document.querySelectorAll('.dashboard-section').forEach(sec => sec.classList.add('hidden'));
    const target = document.getElementById(`section-${targetId}`);
    if (target) {
      target.classList.remove('hidden');
    }

    document.querySelectorAll('.sidebar-link').forEach(l => {
      l.classList.remove('active');
      (l as HTMLElement).style.backgroundColor = 'transparent';
      (l as HTMLElement).style.color = '#94a3b8';
      if (l.getAttribute('data-section') === targetId) {
        l.classList.add('active');
        (l as HTMLElement).style.backgroundColor = '#4f46e5';
        (l as HTMLElement).style.color = '#ffffff';
      }
    });
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('.nav-trigger');
    if (trigger) {
      const target = trigger.getAttribute('data-target');
      if (target) switchDashboardSection(target);
    }
  });

  window.addEventListener('change-section', ((e: CustomEvent) => {
    switchDashboardSection(e.detail);
  }) as EventListener);

  // PREGUNTAS CUESTIONARIO
  const questionsList = [
    { q: "¿Con qué frecuencia te sientes abrumado/a por las tareas escolares o exámenes?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"], weights: [1, 2, 3, 4, 5] },
    { q: "¿Cómo calificarías tu calidad de sueño y descanso durante las últimas dos semanas?", options: ["Excelente", "Buena", "Regular", "Mala", "Muy mala"], weights: [1, 2, 3, 4, 5] },
    { q: "¿Te cuesta concentrarte o mantener la atención en tus clases habituales?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"], weights: [1, 2, 3, 4, 5] },
    { q: "¿Sientes que cuentas con apoyo emocional de amigos o familiares cercanos?", options: ["Siempre", "Frecuentemente", "A veces", "Rara vez", "Nunca"], weights: [5, 4, 3, 2, 1] },
    { q: "¿Experimentas dolores de cabeza, tensión muscular o fatiga sin causa médica?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"], weights: [1, 2, 3, 4, 5] },
    { q: "¿Disfrutas realizando tus actividades diarias y pasatiempos favoritos?", options: ["Siempre", "Frecuentemente", "A veces", "Rara vez", "Nunca"], weights: [5, 4, 3, 2, 1] },
    { q: "¿Te sientes irritable, molesto/a o impaciente con facilidad últimamente?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"], weights: [1, 2, 3, 4, 5] },
    { q: "¿Te consideras capaz de manejar los problemas cotidianos de forma adecuada?", options: ["Siempre", "Frecuentemente", "A veces", "Rara vez", "Nunca"], weights: [5, 4, 3, 2, 1] },
    { q: "¿Has sentido tristeza profunda o falta de motivación sin motivo aparente?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"], weights: [1, 2, 3, 4, 5] },
    { q: "¿Te sientes optimista y con expectativas positivas sobre tu futuro?", options: ["Siempre", "Frecuentemente", "A veces", "Rara vez", "Nunca"], weights: [5, 4, 3, 2, 1] }
  ];

  let currentQIdx = 0;
  let userAnswers = new Array(questionsList.length).fill(0);

  const qTitle = document.getElementById('question-title');
  const qCounter = document.getElementById('question-counter');
  const qProgress = document.getElementById('progress-fill');
  const optionsContainer = document.getElementById('options-container');
  const nextBtn = document.getElementById('next-question');
  const prevBtn = document.getElementById('prev-question');

  function renderQuestion() {
    const current = questionsList[currentQIdx];
    if (qTitle) qTitle.textContent = current.q;
    if (qCounter) qCounter.textContent = `Pregunta ${currentQIdx + 1} de 10`;
    if (qProgress) qProgress.style.width = `${((currentQIdx + 1) / 10) * 100}%`;

    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      current.options.forEach((opt, idx) => {
        const isChecked = userAnswers[currentQIdx] === current.weights[idx];
        const label = document.createElement('label');
        label.style.cssText = "display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 1rem; border: 1px solid " + (isChecked ? "#4f46e5" : "#e2e8f0") + "; background: " + (isChecked ? "#e0e7ff33" : "#ffffff") + "; border-radius: 0.75rem; cursor: pointer; font-weight: 500; color: #0f172a;";
        label.innerHTML = `<input type="radio" name="question-opt" value="${current.weights[idx]}" ${isChecked ? 'checked' : ''} style="accent-color: #4f46e5;" /> ${opt}`;
        
        label.addEventListener('click', () => {
          userAnswers[currentQIdx] = current.weights[idx];
          renderQuestion();
        });

        optionsContainer.appendChild(label);
      });
    }

    if (prevBtn) (prevBtn as HTMLElement).style.display = currentQIdx === 0 ? 'none' : 'block';
    if (nextBtn) nextBtn.textContent = currentQIdx === questionsList.length - 1 ? 'Finalizar evaluación →' : 'Siguiente →';
  }

  nextBtn?.addEventListener('click', () => {
    if (userAnswers[currentQIdx] === 0) {
      alert('Por favor selecciona una opción antes de continuar.');
      return;
    }

    if (currentQIdx < questionsList.length - 1) {
      currentQIdx++;
      renderQuestion();
    } else {
      calculateAndSaveReport();
      switchDashboardSection('reportes');
      currentQIdx = 0;
      userAnswers.fill(0);
      renderQuestion();
    }
  });

  prevBtn?.addEventListener('click', () => {
    if (currentQIdx > 0) {
      currentQIdx--;
      renderQuestion();
    }
  });

  function calculateAndSaveReport() {
    const totalScore = userAnswers.reduce((a, b) => a + b, 0);
    const statusTitle = document.getElementById('report-status-title');
    const statusDesc = document.getElementById('report-status-desc');
    const reportIcon = document.getElementById('report-icon');
    const tableStatus1 = document.getElementById('table-status-1');

    const todayStr = new Date().toLocaleDateString('es-ES');
    const dateCell = document.getElementById('table-date-1');
    if (dateCell) dateCell.textContent = todayStr;

    if (totalScore <= 20) {
      if (statusTitle) statusTitle.textContent = "Tu estado emocional se encuentra en un rango muy estable.";
      if (statusDesc) statusDesc.textContent = "¡Excelente trabajo! Posees buenos mecanismos de afrontamiento.";
      if (reportIcon) { reportIcon.innerHTML = '<i class="fa-solid fa-face-laugh-beam"></i>'; reportIcon.style.color = "#10b981"; }
      if (tableStatus1) { tableStatus1.textContent = "Estable u Óptimo"; tableStatus1.style.color = "#10b981"; }
    } else if (totalScore <= 35) {
      if (statusTitle) statusTitle.textContent = "Tu estado emocional es estable con signos leves de estrés.";
      if (statusDesc) statusDesc.textContent = "Mantén rutinas saludables de descanso y realiza actividades recreativas.";
      if (reportIcon) { reportIcon.innerHTML = '<i class="fa-solid fa-face-smile"></i>'; reportIcon.style.color = "#3b82f6"; }
      if (tableStatus1) { tableStatus1.textContent = "Estable"; tableStatus1.style.color = "#3b82f6"; }
    } else {
      if (statusTitle) statusTitle.textContent = "Se detectaron signos moderados de estrés o ansiedad.";
      if (statusDesc) statusDesc.textContent = "Te sugerimos agendar una cita directa con la psicóloga.";
      if (reportIcon) { reportIcon.innerHTML = '<i class="fa-solid fa-face-frown"></i>'; reportIcon.style.color = "#f59e0b"; }
      if (tableStatus1) { tableStatus1.textContent = "Con signos de estrés"; tableStatus1.style.color = "#f59e0b"; }
    }
    alert('¡Cuestionario completado! Tu evaluación se ha registrado en Mis Reportes.');
  }

  renderQuestion();

  // HORARIOS DE LA PSICÓLOGA CONECTADOS VIA LOCALSTORAGE
  function renderSlots() {
    const container = document.getElementById('slots-container');
    if (!container) return;

    let slots = JSON.parse(localStorage.getItem('psych_slots') || '[]');

    // Si la psicóloga aún no ha configurado horarios, mostramos ejemplos base
    if (slots.length === 0) {
      slots = [
        { id: 1, date: "Martes 10 de Noviembre", time: "10:00 AM - 10:45 AM", mode: "Presencial - Cubículo 2" },
        { id: 2, date: "Martes 10 de Noviembre", time: "03:00 PM - 03:45 PM", mode: "Virtual - Zoom" },
        { id: 3, date: "Jueves 12 de Noviembre", time: "11:00 AM - 11:45 AM", mode: "Presencial - Cubículo 2" }
      ];
    }

    container.innerHTML = '';
    slots.forEach((slot: any) => {
      const card = document.createElement('div');
      card.style.cssText = "display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; background: #f8fafc;";
      card.innerHTML = `
        <div>
          <div style="font-weight: 700; color: #0f172a; font-size: 0.95rem;">${slot.date}</div>
          <div style="font-size: 0.85rem; color: #4f46e5; font-weight: 600; margin-top: 0.2rem;">${slot.time}</div>
          <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.1rem;">${slot.mode}</div>
        </div>
        <button onclick="bookSlot(${slot.id})" style="background: #4f46e5; color: white; border: none; padding: 0.6rem 1.1rem; border-radius: 0.6rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Reservar cita</button>
      `;
      container.appendChild(card);
    });
  }

  (window as any).bookSlot = function(id: number) {
    let slots = JSON.parse(localStorage.getItem('psych_slots') || '[]');
    if (slots.length === 0) {
      slots = [
        { id: 1, date: "Martes 10 de Noviembre", time: "10:00 AM - 10:45 AM", mode: "Presencial - Cubículo 2" },
        { id: 2, date: "Martes 10 de Noviembre", time: "03:00 PM - 03:45 PM", mode: "Virtual - Zoom" },
        { id: 3, date: "Jueves 12 de Noviembre", time: "11:00 AM - 11:45 AM", mode: "Presencial - Cubículo 2" }
      ];
    }

    const idx = slots.findIndex((s: any) => s.id === id);
    if (idx !== -1) {
      const booked = slots.splice(idx, 1)[0];
      localStorage.setItem('psych_slots', JSON.stringify(slots));
      renderSlots();

      const myAppContainer = document.getElementById('my-appointments');
      if (myAppContainer) {
        if (myAppContainer.querySelector('p')) myAppContainer.innerHTML = '';
        const item = document.createElement('div');
        item.style.cssText = "padding: 1rem; background: #e0e7ff; border: 1px solid #c7d2fe; border-radius: 0.75rem; color: #1e1b4b;";
        item.innerHTML = `
          <div style="font-weight: 700; font-size: 0.9rem;">${booked.date}</div>
          <div style="font-size: 0.85rem; color: #4f46e5; font-weight: 600;">${booked.time}</div>
          <div style="font-size: 0.75rem; color: #4338ca; margin-top: 0.25rem;">Estado: <span style="font-weight:700;">Confirmada</span></div>
        `;
        myAppContainer.appendChild(item);
      }
      alert(`¡Cita agendada con éxito para el ${booked.date} a las ${booked.time}!`);
    }
  };

  renderSlots();

  // CHAT CON IA
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const chatMessages = document.getElementById('chat-messages');

  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = chatInput.value.trim();
    if (!text) return;

    const userMsg = document.createElement('div');
    userMsg.style.cssText = "display: flex; justify-content: flex-end;";
    userMsg.innerHTML = `<div style="background: #4f46e5; color: white; padding: 1rem; border-radius: 1rem; max-width: 75%; font-size: 0.95rem;">${text}</div>`;
    chatMessages?.appendChild(userMsg);
    chatInput.value = '';
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

    setTimeout(() => {
      const aiMsg = document.createElement('div');
      aiMsg.style.cssText = "display: flex; gap: 0.75rem; align-items: flex-start;";
      aiMsg.innerHTML = `
        <div style="background: #e0e7ff; color: #4f46e5; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;"><i class="fa-solid fa-robot"></i></div>
        <div style="background: #f1f5f9; padding: 1rem; border-radius: 1rem; max-width: 75%; color: #0f172a; font-size: 0.95rem;">
          Te entiendo perfectamente. Estoy aquí para escucharte y apoyarte. ¿Te gustaría realizar una técnica de respiración guiada o agendar una cita?
        </div>
      `;
      chatMessages?.appendChild(aiMsg);
      if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 1000);
  });

  // SUBIDA DE FOTO REAL EN PERFIL
  const changePhotoBtn = document.getElementById('change-photo-btn');
  const photoInput = document.getElementById('photo-input') as HTMLInputElement;
  const profileAvatarLarge = document.getElementById('profile-avatar-large');

  changePhotoBtn?.addEventListener('click', () => photoInput?.click());

  photoInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(event) {
        const imageUrl = event.target?.result as string;
        if (profileAvatarLarge) {
          profileAvatarLarge.innerHTML = `<img src="${imageUrl}" style="width: 100%; height: 100%; object-fit: cover;" />`;
        }
        const headerAvatar = document.getElementById('header-avatar');
        if (headerAvatar) {
          headerAvatar.innerHTML = `<img src="${imageUrl}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />`;
        }
      };
      reader.readAsDataURL(file);
    }
  });

  const profileForm = document.getElementById('profile-form');
  profileForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const newName = (document.getElementById('profile-name-input') as HTMLInputElement).value;
    if (newName) {
      const headerName = document.getElementById('header-name');
      if (headerName) headerName.textContent = newName;
    }
    alert('¡Datos guardados con éxito!');
  });
</script>