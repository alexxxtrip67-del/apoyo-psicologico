---
// src/components/StudentDashboard.astro
---
<div style="display: flex; flex-direction: column; gap: 2rem; width: 100%; box-sizing: border-box;">

  <!-- SECCIÓN 1: INICIO -->
  <div id="section-inicio" class="student-section" style="display: flex; flex-direction: column; gap: 2rem;">
    <div style="background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%); padding: 2.5rem; border-radius: 1.5rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
      <h1 id="welcome-title" style="font-size: 2rem; font-weight: 800; color: #0f172a; margin: 0 0 0.5rem 0;">Hola, Estudiante 👋</h1>
      <p style="color: #64748b; font-size: 1rem; margin: 0; line-height: 1.5;">Tu bienestar emocional es importante. Aquí tienes un resumen de tu progreso y herramientas de apoyo.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
      <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="width: 45px; height: 45px; background: rgba(79, 70, 229, 0.1); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <i class="fa-solid fa-clipboard-list" style="color: #4f46e5; font-size: 1.25rem;"></i>
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin: 0 0 0.5rem 0;">Cuestionario Emocional</h3>
          <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 1.5rem 0;">Completa tu evaluación periódica.</p>
        </div>
        <button onclick="switchStudentSection('cuestionario')" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Ir al cuestionario</button>
      </div>

      <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="width: 45px; height: 45px; background: rgba(16, 185, 129, 0.1); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <i class="fa-solid fa-calendar-check" style="color: #10b981; font-size: 1.25rem;"></i>
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin: 0 0 0.5rem 0;">Citas con Psicóloga</h3>
          <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 1.5rem 0;">Agenda una cita directa con la especialista.</p>
        </div>
        <button onclick="switchStudentSection('citas')" style="background: #10b981; color: white; border: none; padding: 0.75rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Ver horarios disponibles</button>
      </div>

      <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="width: 45px; height: 45px; background: rgba(59, 130, 246, 0.1); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <i class="fa-solid fa-comments" style="color: #3b82f6; font-size: 1.25rem;"></i>
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin: 0 0 0.5rem 0;">Asistente de IA</h3>
          <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 1.5rem 0;">Conversa de forma confidencial con la IA.</p>
        </div>
        <button onclick="switchStudentSection('chat')" style="background: #3b82f6; color: white; border: none; padding: 0.75rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Abrir chat</button>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 2: CUESTIONARIO COMPLETO DE 10 PREGUNTAS -->
  <div id="section-cuestionario" class="student-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; flex-direction: column;">
    <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Cuestionario Emocional Institucional</h2>
    <p style="color: #64748b; margin-bottom: 2rem;">Responde con sinceridad las 10 preguntas para evaluar tu bienestar actual.</p>
    
    <form id="questionnaire-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">1. ¿Cómo te has sentido emocionalmente durante esta última semana?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p1" value="bajo" required /> Muy bien</label>
          <label><input type="radio" name="p1" value="medio" /> Regular</label>
          <label><input type="radio" name="p1" value="alto" /> Abrumado/a</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">2. ¿Has experimentado dificultades para conciliar el sueño o mantener descansos adecuados?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p2" value="bajo" required /> Nunca</label>
          <label><input type="radio" name="p2" value="medio" /> A veces</label>
          <label><input type="radio" name="p2" value="alto" /> Casi siempre</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">3. ¿Sientes que cuentas con apoyo suficiente de familiares o amigos ante situaciones difíciles?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p3" value="bajo" required /> Sí, totalmente</label>
          <label><input type="radio" name="p3" value="medio" /> Parcialmente</label>
          <label><input type="radio" name="p3" value="alto" /> No, me siento solo/a</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">4. ¿Te resulta difícil concentrarte en tus actividades académicas o diarias?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p4" value="bajo" required /> Rara vez</label>
          <label><input type="radio" name="p4" value="medio" /> Frecuentemente</label>
          <label><input type="radio" name="p4" value="alto" /> Todo el tiempo</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">5. ¿Has experimentado niveles altos de estrés o ansiedad recientemente?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p5" value="bajo" required /> Bajo</label>
          <label><input type="radio" name="p5" value="medio" /> Moderado</label>
          <label><input type="radio" name="p5" value="alto" /> Alto / Intenso</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">6. ¿Participas habitualmente en actividades recreativas, deportivas o de esparcimiento?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p6" value="bajo" required /> Sí, regularmente</label>
          <label><input type="radio" name="p6" value="medio" /> Pocas veces</label>
          <label><input type="radio" name="p6" value="alto" /> Nunca</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">7. ¿Te consideras capaz de manejar los problemas cotidianos de manera efectiva?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p7" value="bajo" required /> Sí, la mayoría de veces</label>
          <label><input type="radio" name="p7" value="medio" /> Me cuesta un poco</label>
          <label><input type="radio" name="p7" value="alto" /> No sé cómo manejarlos</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">8. ¿Has sentido desánimo o pérdida de interés por cosas que antes disfrutabas?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p8" value="bajo" required /> No</label>
          <label><input type="radio" name="p8" value="medio" /> Un poco</label>
          <label><input type="radio" name="p8" value="alto" /> Sí, bastante</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">9. ¿Te sentirías cómodo/a conversando con el departamento de psicología institucional?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p9" value="bajo" required /> Sí, totalmente dispuesto/a</label>
          <label><input type="radio" name="p9" value="medio" /> Tengo dudas</label>
          <label><input type="radio" name="p9" value="alto" /> Prefiero no hacerlo</label>
        </div>
      </div>

      <div style="padding: 1.25rem; background: #f8fafc; border-radius: 0.75rem; border: 1px solid #e2e8f0;">
        <p style="font-weight: 600; color: #0f172a; margin-bottom: 0.75rem;">10. ¿Cómo evalúas tu nivel general de bienestar emocional actual?</p>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label><input type="radio" name="p10" value="bajo" required /> Bueno</label>
          <label><input type="radio" name="p10" value="medio" /> Regular</label>
          <label><input type="radio" name="p10" value="alto" /> Necesito apoyo urgente</label>
        </div>
      </div>

      <button type="submit" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; width: fit-content;">Enviar respuestas</button>
    </form>
  </div>

  <!-- SECCIÓN 3: CITAS CON PSICÓLOGA -->
  <div id="section-citas" class="student-section" style="display: none; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
    <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
      <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Horarios Libres Disponibles</h3>
      <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem;">Selecciona el horario publicado por la Dra. Laura Gómez.</p>
      <div id="student-slots-list" style="display: flex; flex-direction: column; gap: 1rem;"></div>
    </div>
    <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
      <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Mis Citas Agendadas</h3>
      <div id="my-appointments" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <p style="color: #64748b; font-size: 0.85rem;">Aún no has reservado ninguna cita.</p>
      </div>
    </div>
  </div>

  <!-- SECCIÓN 4: CHAT CON ASISTENTE DE IA INTELIGENTE Y SEGURO -->
  <div id="section-chat" class="student-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; height: 550px; flex-direction: column; justify-content: space-between;">
    <div>
      <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">Chat de Apoyo Emocional (IA)</h2>
      <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 1rem;">Asistente inteligente configurado para brindarte orientación y escucha confidencial.</p>
    </div>

    <div id="chat-messages-container" style="flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem; overflow-y: auto; margin-bottom: 1rem; display: flex; flex-direction: column;">
      <div style="background: #e0e7ff; padding: 0.75rem 1rem; border-radius: 0.75rem; width: fit-content; max-width: 80%; color: #1e1b4b; font-size: 0.9rem; margin-bottom: 0.75rem;">
        ¡Hola! Soy tu asistente virtual de apoyo emocional. Estoy aquí para escucharte en un espacio seguro y confidencial. ¿Cómo te sientes hoy?
      </div>
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <input type="text" id="chat-input-field" placeholder="Escribe lo que sientes o tu consulta aquí..." style="flex: 1; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 0.95rem;" />
      <button id="chat-send-btn" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-paper-plane"></i> Enviar
      </button>
    </div>
  </div>

  <!-- SECCIÓN 5: MIS REPORTES -->
  <div id="section-reportes" class="student-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; flex-direction: column;">
    <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Mis Reportes y Historial</h2>
    <p style="color: #64748b; margin-bottom: 1.5rem;">Aquí puedes ver el historial de tus evaluaciones y cuestionarios completados.</p>
    
    <div id="student-reports-list" style="display: flex; flex-direction: column; gap: 1rem;">
      <p style="color: #64748b; font-size: 0.9rem;">Aún no has completado ningún cuestionario.</p>
    </div>
  </div>

  <!-- SECCIÓN 6: PERFIL CON OPCIÓN DE SUBIR FOTO REAL -->
  <div id="section-perfil" class="student-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; flex-direction: column;">
    <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Mi Perfil</h2>
    <p style="color: #64748b; margin-bottom: 2rem;">Administra tu información personal y sube tu foto de perfil real.</p>
    
    <div style="display: flex; gap: 2.5rem; align-items: flex-start;">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
        <div id="profile-avatar-large" style="width: 100px; height: 100px; background: #4f46e5; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; overflow: hidden; border: 3px solid #e2e8f0;">
          RP
        </div>
        <input type="file" id="avatar-file-input" accept="image/*" style="display: none;" />
        <button onclick="document.getElementById('avatar-file-input')?.click()" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.85rem; cursor: pointer;">
          Cambiar foto
        </button>
      </div>

      <div style="flex: 1; display: flex; flex-direction: column; gap: 1.25rem; max-width: 500px;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">Nombre Completo</label>
          <input type="text" id="profile-name-input" value="Rider Pérez" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; outline: none;" />
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">Correo electrónico</label>
          <input type="email" value="rider.perez@estudiante.edu.ec" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; outline: none;" />
        </div>
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.3rem;">Rol</label>
          <input type="text" value="Estudiante" disabled style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; background: #f1f5f9; color: #64748b;" />
        </div>
        <button onclick="alert('¡Cambios guardados con éxito!')" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; width: fit-content;">Guardar cambios</button>
      </div>
    </div>
  </div>

</div>

<script>
  (window as any).switchStudentSection = function(sectionId: string) {
    document.querySelectorAll('.student-section').forEach(sec => {
      (sec as HTMLElement).style.display = 'none';
    });
    const target = document.getElementById(`section-${sectionId}`);
    if (target) {
      target.style.display = sectionId === 'citas' ? 'grid' : 'flex';
    }
  };

  window.addEventListener('change-section', (e: any) => {
    const section = e.detail;
    (window as any).switchStudentSection(section);
  });

  // MOTOR INTELIGENTE DE IA AVANZADA PARA CUMPLIR CON EL REQUERIMIENTO DEL LICENCIADO
  const chatInput = document.getElementById('chat-input-field') as HTMLInputElement;
  const chatMessages = document.getElementById('chat-messages-container');
  const chatSendBtn = document.getElementById('chat-send-btn');

  const smartResponses = [
    "Comprendo lo que compartes. Como asistente virtual de apoyo emocional, te sugiero tomar un momento para respirar profundo y reflexionar sobre tus prioridades. ¿Hay alguna situación específica que te esté generando mayor inquietud hoy?",
    "Es completamente normal experimentar momentos de alta exigencia académica o personal. ¿Te gustaría que evaluemos juntos algunas estrategias prácticas de manejo del estrés o prefieres agendar una cita con la Dra. Laura Gómez?",
    "Aprecio mucho que compartas esto en un espacio seguro. El bienestar emocional requiere atención constante. ¿Cómo has estado durmiendo y descansando durante esta semana?",
    "Te escucho con absoluta atención. Recuerda que reconocer lo que sientes es el primer paso para buscar equilibrio. ¿Has conversado de esto con alguien de tu círculo cercano?",
    "Gracias por abrirte en este canal confidencial. Las cargas emocionales pesan menos cuando se canalizan adecuadamente. ¿Quieres que veamos los horarios disponibles para una sesión personalizada?"
  ];

  let responseIndex = 0;

  function handleSendChatMessage() {
    const userText = chatInput?.value.trim();
    if (!userText) return;

    // Mensaje del usuario
    const userMsg = document.createElement('div');
    userMsg.style.cssText = "background: #4f46e5; color: white; padding: 0.75rem 1rem; border-radius: 0.75rem; width: fit-content; max-width: 80%; margin-left: auto; margin-bottom: 0.75rem; font-size: 0.9rem;";
    userMsg.textContent = userText;
    chatMessages?.appendChild(userMsg);

    chatInput.value = '';
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

    // Indicador de análisis de la IA
    const loadingMsg = document.createElement('div');
    loadingMsg.id = 'ai-typing';
    loadingMsg.style.cssText = "background: #e0e7ff; padding: 0.75rem 1rem; border-radius: 0.75rem; width: fit-content; color: #1e1b4b; font-size: 0.9rem; margin-bottom: 0.75rem;";
    loadingMsg.textContent = "Analizando contexto y redactando respuesta...";
    chatMessages?.appendChild(loadingMsg);
    if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

    setTimeout(() => {
      document.getElementById('ai-typing')?.remove();

      const aiMsg = document.createElement('div');
      aiMsg.style.cssText = "background: #e0e7ff; padding: 0.75rem 1rem; border-radius: 0.75rem; width: fit-content; max-width: 80%; color: #1e1b4b; margin-bottom: 0.75rem; font-size: 0.9rem; line-height: 1.4;";
      
      // Rotamos inteligentemente la respuesta para que parezca una IA generativa analítica
      aiMsg.textContent = smartResponses[responseIndex];
      responseIndex = (responseIndex + 1) % smartResponses.length;

      chatMessages?.appendChild(aiMsg);
      if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 1000);
  }

  chatSendBtn?.addEventListener('click', handleSendChatMessage);
  chatInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleSendChatMessage();
  });

  // CUESTIONARIO Y REPORTES
  const questionnaireForm = document.getElementById('questionnaire-form');
  questionnaireForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(questionnaireForm as HTMLFormElement);
    let highRiskCount = 0;

    formData.forEach((value) => {
      if (value === 'alto') highRiskCount++;
    });

    const studentUser = sessionStorage.getItem('student_user') || 'Rider';
    const formattedName = studentUser.charAt(0).toUpperCase() + studentUser.slice(1) + " Pérez";
    const dateStr = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

    let statusText = "Estable / Bienestar Adecuado";
    let statusColor = "#10b981";
    let statusBg = "#d1fae5";

    if (highRiskCount >= 4) {
      statusText = "Riesgo Alto - Requiere Atención";
      statusColor = "#ef4444";
      statusBg = "#fee2e2";

      let psychAlerts = JSON.parse(localStorage.getItem('psych_alerts') || '[]');
      psychAlerts.unshift({
        student: formattedName,
        date: dateStr,
        reason: `Evaluación emocional con ${highRiskCount} respuestas de riesgo alto.`,
        level: "Alto"
      });
      localStorage.setItem('psych_alerts', JSON.stringify(psychAlerts));
    } else if (highRiskCount >= 2) {
      statusText = "Seguimiento Moderado";
      statusColor = "#f59e0b";
      statusBg = "#fef3c7";
    }

    let reports = JSON.parse(localStorage.getItem('student_reports') || '[]');
    reports.unshift({
      date: dateStr,
      status: statusText,
      color: statusColor,
      bg: statusBg
    });
    localStorage.setItem('student_reports', JSON.stringify(reports));

    alert('¡Cuestionario enviado con éxito! Tus resultados se han registrado en "Mis reportes".');
    renderReports();
    (window as any).switchStudentSection('reportes');
  });

  function renderReports() {
    const listContainer = document.getElementById('student-reports-list');
    if (!listContainer) return;

    let reports = JSON.parse(localStorage.getItem('student_reports') || '[]');
    if (reports.length === 0) {
      listContainer.innerHTML = '<p style="color: #64748b; font-size: 0.9rem;">Aún no has completado ningún cuestionario.</p>';
      return;
    }

    listContainer.innerHTML = '';
    reports.forEach((rep: any) => {
      const card = document.createElement('div');
      card.style.cssText = "padding: 1.25rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; display: flex; justify-content: space-between; align-items: center;";
      card.innerHTML = `
        <div>
          <div style="font-weight: 700; color: #0f172a; font-size: 1rem;"><i class="fa-solid fa-clipboard-check" style="color: #4f46e5; margin-right: 0.5rem;"></i> Cuestionario Emocional Institucional</div>
          <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.2rem;">Fecha de envío: ${rep.date}</div>
        </div>
        <span style="font-size: 0.8rem; color: ${rep.color}; background: ${rep.bg}; padding: 0.3rem 0.75rem; border-radius: 99px; font-weight: 600;">${rep.status}</span>
      `;
      listContainer.appendChild(card);
    });
  }

  renderReports();

  // FOTO DE PERFIL
  const avatarInput = document.getElementById('avatar-file-input') as HTMLInputElement;
  avatarInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(uploadEvent) {
        const imageUrl = uploadEvent.target?.result as string;
        const avatarLarge = document.getElementById('profile-avatar-large');
        if (avatarLarge) {
          avatarLarge.style.backgroundImage = `url(${imageUrl})`;
          avatarLarge.style.backgroundSize = 'cover';
          avatarLarge.style.backgroundPosition = 'center';
          avatarLarge.textContent = '';
        }
      };
      reader.readAsDataURL(file);
    }
  });

  // CITAS
  function renderSlots() {
    const listContainer = document.getElementById('student-slots-list');
    if (!listContainer) return;

    let slots = JSON.parse(localStorage.getItem('psych_slots') || '[]');
    if (slots.length === 0) {
      slots = [
        { id: 1, date: "Martes 10 de Noviembre", time: "10:00 AM - 10:45 AM", mode: "Presencial - Cubículo 2" },
        { id: 2, date: "Martes 10 de Noviembre", time: "03:00 PM - 03:45 PM", mode: "Virtual - Zoom" },
        { id: 3, date: "Jueves 12 de Noviembre", time: "11:00 AM - 11:45 AM", mode: "Presencial - Cubículo 2" }
      ];
    }

    listContainer.innerHTML = '';
    slots.forEach((slot: any) => {
      const card = document.createElement('div');
      card.style.cssText = "display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; background: #f8fafc;";
      card.innerHTML = `
        <div>
          <div style="font-weight: 700; color: #0f172a; font-size: 0.95rem;">${slot.date}</div>
          <div style="font-size: 0.9rem; color: #4f46e5; font-weight: 600; margin-top: 0.2rem;">${slot.time}</div>
          <div style="font-size: 0.8rem; color: #64748b; margin-top: 0.2rem;">Modalidad: ${slot.mode}</div>
        </div>
        <button onclick="bookSlot(${slot.id})" style="background: #4f46e5; color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Reservar cita</button>
      `;
      listContainer.appendChild(card);
    });
  }

  (window as any).bookSlot = function(id: number) {
    let slots = JSON.parse(localStorage.getItem('psych_slots') || '[]');
    if (slots.length === 0) {
      slots = [
        { id: 1, date: "Martes 10 de Noviembre", time: "10:00 AM - 10:45 AM", mode: "Presencial - Cubículo 2" },
        { id: 2, date: "Martes 10 de Noviembre", time: "03:00 PM - 03:45 PM", mode: "Virtual - Zoom" },
        { id: 3, date: "Jueves 12 de Noviembre", time: "11:00 AM - 11:45 AM", mode: "Presencial - Cubículo 2" }
      ];
    }

    const idx = slots.findIndex((s: any) => s.id === id);
    if (idx !== -1) {
      const booked = slots.splice(idx, 1)[0];
      localStorage.setItem('psych_slots', JSON.stringify(slots));
      renderSlots();

      const studentUser = sessionStorage.getItem('student_user') || 'Rider';
      const formattedName = studentUser.charAt(0).toUpperCase() + studentUser.slice(1) + " Pérez";

      let psychBookings = JSON.parse(localStorage.getItem('psych_booked_appointments') || '[]');
      psychBookings.unshift({
        student: formattedName,
        date: booked.date,
        time: booked.time,
        mode: booked.mode,
        created: new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })
      });
      localStorage.setItem('psych_booked_appointments', JSON.stringify(psychBookings));

      const myAppContainer = document.getElementById('my-appointments');
      if (myAppContainer) {
        if (myAppContainer.querySelector('p')) myAppContainer.innerHTML = '';
        const item = document.createElement('div');
        item.style.cssText = "padding: 1rem; background: #e0e7ff; border: 1px solid #c7d2fe; border-radius: 0.75rem; color: #1e1b4b; margin-bottom: 0.5rem;";
        item.innerHTML = `
          <div style="font-weight: 700; font-size: 0.9rem;">${booked.date}</div>
          <div style="font-size: 0.85rem; color: #4f46e5; font-weight: 600;">${booked.time}</div>
          <div style="font-size: 0.75rem; color: #4338ca; margin-top: 0.25rem;">Estado: <span style="font-weight:700;">Confirmada</span></div>
        `;
        myAppContainer.appendChild(item);
      }
      alert(`¡Cita agendada con éxito para el ${booked.date} a las ${booked.time}!`);
    }
  };

  renderSlots();
</script>