---
// src/components/Quiz.astro
---
<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-white">Cuestionario de bienestar emocional</h2>
      <p class="text-xs text-slate-400">Responde con sinceridad. No hay respuestas correctas o incorrectas.</p>
    </div>
    <span class="text-xs text-indigo-400 font-semibold bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Pregunta 3 de 10</span>
  </div>

  <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
    <div class="bg-indigo-500 h-full w-1/3 rounded-full"></div>
  </div>

  <div class="bg-[#1c2541]/50 p-6 rounded-2xl border border-slate-800 space-y-6">
    <h3 class="text-sm font-semibold text-white">¿Con qué frecuencia te sientes ansioso/a o preocupado/a?</h3>
    
    <div class="space-y-3">
      <label class="flex items-center space-x-3 p-3.5 rounded-xl bg-[#0b132b] border border-slate-700 cursor-pointer hover:border-indigo-500 transition">
        <input type="radio" name="quiz" class="accent-indigo-500" />
        <span class="text-xs text-slate-300">Nunca</span>
      </label>
      <label class="flex items-center space-x-3 p-3.5 rounded-xl bg-[#0b132b] border border-slate-700 cursor-pointer hover:border-indigo-500 transition">
        <input type="radio" name="quiz" class="accent-indigo-500" />
        <span class="text-xs text-slate-300">Rara vez</span>
      </label>
      <label class="flex items-center space-x-3 p-3.5 rounded-xl bg-[#0b132b] border border-indigo-500 bg-indigo-950/20 cursor-pointer transition">
        <input type="radio" name="quiz" checked class="accent-indigo-500" />
        <span class="text-xs text-white font-medium">A veces</span>
      </label>
      <label class="flex items-center space-x-3 p-3.5 rounded-xl bg-[#0b132b] border border-slate-700 cursor-pointer hover:border-indigo-500 transition">
        <input type="radio" name="quiz" class="accent-indigo-500" />
        <span class="text-xs text-slate-300">Frecuentemente</span>
      </label>
      <label class="flex items-center space-x-3 p-3.5 rounded-xl bg-[#0b132b] border border-slate-700 cursor-pointer hover:border-indigo-500 transition">
        <input type="radio" name="quiz" class="accent-indigo-500" />
        <span class="text-xs text-slate-300">Siempre</span>
      </label>
    </div>

    <div class="flex justify-between pt-4 border-t border-slate-800">
      <button class="px-4 py-2 border border-slate-700 text-slate-300 text-xs rounded-xl hover:bg-slate-800 transition">Anterior</button>
      <button onclick="switchView('student-reports')" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl transition">Siguiente</button>
    </div>
  </div>
</div>