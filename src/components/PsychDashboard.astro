---
// src/components/PsychDashboard.astro
---
<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold text-white">Panel de control</h2>
    <p class="text-xs text-slate-400">Resumen general del sistema de asistencia psicológica.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-[#1c2541]/50 p-5 rounded-2xl border border-slate-800">
      <p class="text-xs text-slate-400">Total de estudiantes</p>
      <h3 class="text-2xl font-extrabold text-white mt-1">1248</h3>
      <span class="text-[10px] text-emerald-400 font-semibold"><i class="fa-solid fa-arrow-up"></i> 12% vs mes anterior</span>
    </div>
    <div class="bg-[#1c2541]/50 p-5 rounded-2xl border border-slate-800">
      <p class="text-xs text-slate-400">Cuestionarios completados</p>
      <h3 class="text-2xl font-extrabold text-white mt-1">1120</h3>
      <span class="text-[10px] text-emerald-400 font-semibold"><i class="fa-solid fa-arrow-up"></i> 8%</span>
    </div>
    <div class="bg-[#1c2541]/50 p-5 rounded-2xl border border-slate-800">
      <p class="text-xs text-slate-400">Casos en seguimiento</p>
      <h3 class="text-2xl font-extrabold text-white mt-1">18</h3>
      <span class="text-[10px] text-amber-400 font-semibold"><i class="fa-solid fa-arrow-up"></i> 5%</span>
    </div>
    <div class="bg-[#1c2541]/50 p-5 rounded-2xl border border-slate-800">
      <p class="text-xs text-slate-400">Alertas activas</p>
      <h3 class="text-2xl font-extrabold text-red-400 mt-1">3</h3>
      <span class="text-[10px] text-red-400 font-semibold"><i class="fa-solid fa-arrow-up"></i> 2 urgentes</span>
    </div>
  </div>
</div>