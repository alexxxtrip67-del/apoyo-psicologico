---
// src/components/PsychDashboard.astro
---
<div style="display: flex; flex-direction: column; gap: 2rem; width: 100%; box-sizing: border-box;">

  <!-- ENCABEZADO PROFESIONAL LIMPIO -->
  <div style="background: white; padding: 2rem 2.5rem; border-radius: 1.5rem; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
    <div>
      <h1 style="font-size: 1.8rem; font-weight: 800; color: #0f172a; margin: 0 0 0.25rem 0;">Panel de Control - Dra. Laura Gómez</h1>
      <p style="color: #64748b; font-size: 0.9rem; margin: 0;">Gestión institucional de bienestar y seguimiento estudiantil.</p>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="width: 50px; height: 50px; background: #4f46e5; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem;">
        LG
      </div>
      <div>
        <div style="font-weight: 700; color: #0f172a; font-size: 1rem;">Dra. Laura Gómez</div>
        <div style="font-size: 0.8rem; color: #10b981; font-weight: 600;">Psicóloga Titular</div>
      </div>
    </div>
  </div>

  <!-- ESTADÍSTICAS / ALERTAS ACTIVAS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
    <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
      <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem;">Alertas Activas</div>
      <div id="alerts-counter" style="font-size: 2rem; font-weight: 800; color: #ef4444;">0</div>
    </div>
    <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
      <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem;">Citas Solicitadas</div>
      <div id="appointments-counter" style="font-size: 2rem; font-weight: 800; color: #4f46e5;">0</div>
    </div>
  </div>

  <!-- GESTIÓN Y CONFIRMACIÓN DE CITAS -->
  <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
    <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Solicitudes de Citas de Estudiantes</h3>
    <div id="psych-appointments-list" style="display: flex; flex-direction: column; gap: 1rem;">
      <p style="color: #64748b; font-size: 0.9rem;">No hay citas pendientes de confirmación.</p>
    </div>
  </div>

  <!-- ALERTAS DE ESTUDIANTES EN RIESGO -->
  <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
    <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Historial de Alertas Automáticas</h3>
    <div id="psych-alerts-list" style="display: flex; flex-direction: column; gap: 1rem;">
      <p style="color: #64748b; font-size: 0.9rem;">No hay alertas activas en el sistema.</p>
    </div>
  </div>

</div>

<script>
  function renderPsychDashboard() {
    // Renderizar Alertas
    const alertsList = document.getElementById('psych-alerts-list');
    const alertsCounter = document.getElementById('alerts-counter');
    const alerts = JSON.parse(localStorage.getItem('psych_alerts') || '[]');
    
    if (alertsCounter) alertsCounter.textContent = alerts.length.toString();

    if (alertsList && alerts.length > 0) {
      alertsList.innerHTML = '';
      alerts.forEach((alertData: any) => {
        const card = document.createElement('div');
        card.style.cssText = "padding: 1.25rem; background: #fee2e2; border: 1px solid #fca5a5; border-radius: 0.75rem; display: flex; justify-content: space-between; align-items: center;";
        card.innerHTML = `
          <div>
            <div style="font-weight: 700; color: #991b1b; font-size: 1rem;">${alertData.student}</div>
            <div style="font-size: 0.85rem; color: #7f1d1d; margin-top: 0.2rem;">${alertData.reason}</div>
            <div style="font-size: 0.75rem; color: #991b1b; margin-top: 0.2rem;">Fecha: ${alertData.date}</div>
          </div>
          <span style="font-size: 0.8rem; color: white; background: #ef4444; padding: 0.3rem 0.75rem; border-radius: 99px; font-weight: 600;">Riesgo Alto</span>
        `;
        alertsList.appendChild(card);
      });
    }

    // Renderizar Citas para confirmar
    const appList = document.getElementById('psych-appointments-list');
    const appCounter = document.getElementById('appointments-counter');
    let bookings = JSON.parse(localStorage.getItem('psych_booked_appointments') || '[]');

    if (appCounter) appCounter.textContent = bookings.length.toString();

    if (appList) {
      if (bookings.length === 0) {
        appList.innerHTML = '<p style="color: #64748b; font-size: 0.9rem;">No hay solicitudes de citas pendientes.</p>';
        return;
      }

      appList.innerHTML = '';
      bookings.forEach((b: any) => {
        const isConfirmed = b.status === 'Confirmada';
        const card = document.createElement('div');
        card.style.cssText = "display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; background: #f8fafc;";
        card.innerHTML = `
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 1rem;">Estudiante: ${b.student}</div>
            <div style="font-size: 0.9rem; color: #4f46e5; font-weight: 600; margin-top: 0.2rem;">${b.date} - ${b.time}</div>
            <div style="font-size: 0.8rem; color: #64748b; margin-top: 0.2rem;">Modalidad: ${b.mode} | Estado: <span style="font-weight:700; color:${isConfirmed ? '#10b981' : '#f59e0b'};">${b.status}</span></div>
          </div>
          ${!isConfirmed ? `<button onclick="confirmBooking(${b.id})" style="background: #10b981; color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Confirmar Cita</button>` : `<span style="color: #10b981; font-weight: 600; font-size: 0.85rem;"><i class="fa-solid fa-check-circle"></i> Confirmada</span>`}
        `;
        appList.appendChild(card);
      });
    }
  }

  (window as any).confirmBooking = function(id: number) {
    let bookings = JSON.parse(localStorage.getItem('psych_booked_appointments') || '[]');
    const index = bookings.findIndex((b: any) => b.id === id);
    if (index !== -1) {
      bookings[index].status = 'Confirmada';
      localStorage.setItem('psych_booked_appointments', JSON.stringify(bookings));
      renderPsychDashboard();
      alert('¡Cita confirmada con éxito! El estudiante verá la confirmación en su panel.');
    }
  };

  renderPsychDashboard();
</script>