---
// src/components/Login.astro
---
<div id="view-login-wrapper" style="display: flex; width: 100vw; height: 100vh; background-color: #f8fafc; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; z-index: 9999;">
  <div style="display: flex; width: 900px; background: white; border-radius: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.08); overflow: hidden; border: 1px solid #e2e8f0;">
    
    <!-- Columna Izquierda: Formulario -->
    <div style="flex: 1; padding: 3rem; display: flex; flex-direction: column; justify-content: center;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
        <div style="background: rgba(99, 102, 241, 0.1); padding: 0.5rem; border-radius: 0.75rem;">
          <i class="fa-solid fa-brain" style="color: #4f46e5; font-size: 1.5rem;"></i>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0;">Apoyo Psicológico</h2>
      </div>

      <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Bienvenido/a</h3>
      <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.25rem;">Selecciona tu rol para ingresar.</p>

      <!-- Selector de Rol -->
      <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem; background: #f1f5f9; padding: 0.35rem; border-radius: 0.75rem;">
        <button type="button" id="role-student-btn" style="flex: 1; padding: 0.5rem; border: none; border-radius: 0.5rem; font-weight: 600; cursor: pointer; background: #4f46e5; color: white;">Estudiante</button>
        <button type="button" id="role-psych-btn" style="flex: 1; padding: 0.5rem; border: none; border-radius: 0.5rem; font-weight: 600; cursor: pointer; background: transparent; color: #64748b;">Psicóloga</button>
      </div>

      <form id="login-form" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label id="user-label" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">Usuario o Correo</label>
          <input type="text" id="login-user" placeholder="ej. rider.perez" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 0.95rem;" />
        </div>

        <div>
          <label id="pass-label" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">Número de Cédula (Solo números)</label>
          <input type="text" id="login-pass" inputmode="numeric" pattern="[0-9]*" placeholder="Ingresa solo números" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 0.95rem;" />
        </div>

        <button type="submit" style="background: #4f46e5; color: white; border: none; padding: 0.85rem; border-radius: 0.75rem; font-weight: 600; font-size: 1rem; cursor: pointer; margin-top: 0.5rem; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);">
          Iniciar sesión
        </button>
      </form>
    </div>

    <!-- Columna Derecha -->
    <div style="flex: 1; background: linear-gradient(135deg, #0b132b 0%, #1c2541 100%); padding: 3rem; display: flex; flex-direction: column; justify-content: center; color: white; text-align: center;">
      <div style="font-size: 3.5rem; color: #818cf8; margin-bottom: 1.5rem;"><i class="fa-solid fa-shield-heart"></i></div>
      <h3 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem;">Espacio Seguro e Institucional</h3>
      <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6;">Plataforma de bienestar emocional para el acompañamiento y seguimiento académico y psicológico.</p>
    </div>

  </div>
</div>

<script>
  let selectedRole = 'student';

  const roleStudentBtn = document.getElementById('role-student-btn');
  const rolePsychBtn = document.getElementById('role-psych-btn');
  const userInput = document.getElementById('login-user') as HTMLInputElement;
  const userLabel = document.getElementById('user-label');
  const passInput = document.getElementById('login-pass') as HTMLInputElement;
  const passLabel = document.getElementById('pass-label');

  roleStudentBtn?.addEventListener('click', () => {
    selectedRole = 'student';
    roleStudentBtn.style.background = '#4f46e5';
    roleStudentBtn.style.color = '#ffffff';
    rolePsychBtn!.style.background = 'transparent';
    rolePsychBtn!.style.color = '#64748b';
    if (userInput) userInput.placeholder = 'ej. rider.perez';
    if (userLabel) userLabel.textContent = 'Usuario o Correo del Estudiante';
    if (passInput) passInput.placeholder = 'Número de cédula (solo números)';
    if (passLabel) passLabel.textContent = 'Número de Cédula (Solo números)';
  });

  rolePsychBtn?.addEventListener('click', () => {
    selectedRole = 'psych';
    rolePsychBtn.style.background = '#4f46e5';
    rolePsychBtn.style.color = '#ffffff';
    roleStudentBtn!.style.background = 'transparent';
    roleStudentBtn!.style.color = '#64748b';
    if (userInput) userInput.placeholder = 'Dra. Laura Gómez';
    if (userLabel) userLabel.textContent = 'Nombre de la Psicóloga';
    if (passInput) passInput.placeholder = 'Código institucional (Ej: 2026)';
    if (passLabel) passLabel.textContent = 'Código Único de Acceso (Números)';
  });

  // Validar que en el campo de contraseña solo se ingresen números
  passInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    target.value = target.value.replace(/[^0-9]/g, '');
  });

  const loginForm = document.getElementById('login-form');
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const userVal = userInput.value.trim();
    const passVal = passInput.value.trim();

    const loginWrapper = document.getElementById('view-login-wrapper');
    const studentApp = document.getElementById('app');
    const psychApp = document.getElementById('psych-app');

    if (selectedRole === 'psych') {
      if (passVal === '2026' || passVal.length >= 4) {
        if (loginWrapper) loginWrapper.style.display = 'none';
        if (studentApp) studentApp.style.display = 'none';
        if (psychApp) psychApp.style.display = 'flex';
      } else {
        alert('Código de acceso incorrecto. Debe ser numérico (Ej: 2026)');
      }
    } else {
      if (loginWrapper) loginWrapper.style.display = 'none';
      if (psychApp) psychApp.style.display = 'none';
      if (studentApp) studentApp.style.display = 'flex';

      let firstName = "Estudiante";
      if (userVal.includes('.')) {
        const parts = userVal.split('.');
        firstName = parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
      } else if (userVal.length > 0) {
        firstName = userVal.charAt(0).toUpperCase() + userVal.slice(1);
      }

      const welcomeTitle = document.getElementById('welcome-title');
      const headerName = document.getElementById('header-name');
      const headerAvatar = document.getElementById('header-avatar');
      const profileNameInput = document.getElementById('profile-name-input') as HTMLInputElement;
      const profileAvatarLarge = document.getElementById('profile-avatar-large');

      if (welcomeTitle) welcomeTitle.textContent = `Hola, ${firstName} 👋`;
      if (headerName) headerName.textContent = firstName + " Pérez";
      if (headerAvatar) headerAvatar.textContent = firstName.substring(0, 2).toUpperCase();
      if (profileNameInput) profileNameInput.value = firstName + " Pérez";
      if (profileAvatarLarge) profileAvatarLarge.textContent = firstName.substring(0, 2).toUpperCase();
    }
  });
</script>