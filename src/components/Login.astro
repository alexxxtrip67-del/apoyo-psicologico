---
// src/components/Login.astro
---

<div class="login-page-wrapper" id="view-login-wrapper">
  <!-- LADO IZQUIERDO: Ilustración y textos de bienvenida -->
  <div class="welcome-side">
    <div class="logo-area" style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="background: rgba(99, 102, 241, 0.2); padding: 0.5rem; border-radius: 0.75rem;">
        <i class="fa-solid fa-brain" style="color: #818cf8; font-size: 1.5rem;"></i>
      </div>
      <div>
        <h3 style="color: #ffffff; font-size: 1.15rem; font-weight: 700; margin: 0;">Apoyo Psicológico</h3>
        <p style="color: #94a3b8; font-size: 0.8rem; margin: 0;">Tu bienestar también importa</p>
      </div>
    </div>

    <div>
      <h1>Hablar también es cuidarte</h1>
      <p>Aquí puedes encontrar apoyo, resolver tus dudas y recibir orientación de forma segura y confidencial.</p>
    </div>

    <div class="info-card-box">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <i class="fa-solid fa-shield-halved" style="color: #818cf8; font-size: 1.25rem;"></i>
        <span>Plataforma totalmente confidencial y supervisada por profesionales de la salud mental.</span>
      </div>
    </div>
  </div>

  <!-- LADO DERECHO: Tarjeta Blanca de Inicio de Sesión -->
  <div class="login-card">
    <h2>Iniciar sesión</h2>
    <p id="login-subtitle">Accede a tu cuenta de estudiante para continuar</p>

    <!-- Selector de Roles -->
    <div class="role-tabs">
      <button type="button" class="role-btn active" id="btn-estudiante">Estudiante</button>
      <button type="button" class="role-btn" id="btn-psicologa">Psicóloga</button>
    </div>

    <!-- Formulario de Acceso -->
    <form id="login-form">
      <div style="margin-bottom: 1rem;">
        <label id="label-user" for="username" style="display: block; font-size: 0.85rem; font-weight: 600; color: #1e293b; margin-bottom: 0.4rem;">
          Usuario
        </label>
        <div style="position: relative;">
          <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #64748b;">
            <i class="fa-regular fa-user"></i>
          </span>
          <input 
            type="text" 
            id="username" 
            placeholder="rider.espinoza" 
            style="padding-left: 2.5rem !important;"
            required 
          />
        </div>
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label id="label-pass" for="password" style="display: block; font-size: 0.85rem; font-weight: 600; color: #1e293b; margin-bottom: 0.4rem;">
          Contraseña
        </label>
        <div style="position: relative;">
          <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #64748b;">
            <i class="fa-solid fa-lock"></i>
          </span>
          <input 
            type="password" 
            id="password" 
            placeholder="Número de cédula" 
            style="padding-left: 2.5rem !important; padding-right: 2.5rem !important;"
            required 
          />
          <button 
            type="button" 
            id="toggle-password" 
            style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: transparent !important; border: none !important; box-shadow: none !important; color: #64748b; cursor: pointer; padding: 0.25rem;"
          >
            <i class="fa-regular fa-eye" id="eye-icon"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn-submit">Entrar</button>
    </form>

    <div style="text-align: center; margin-top: 1.25rem;">
      <a href="#" style="color: #4f46e5; font-size: 0.85rem; text-decoration: none; font-weight: 500;">
        ¿Olvidaste tu contraseña?
      </a>
    </div>

    <div style="text-align: center; margin-top: 1rem; font-size: 0.85rem; color: #64748b;">
      ¿No tienes una cuenta? <a href="#" style="color: #4f46e5; text-decoration: none; font-weight: 600;">Regístrate</a>
    </div>
  </div>
</div>

<script>
  // Selección de elementos del DOM
  const btnEstudiante = document.getElementById('btn-estudiante');
  const btnPsicologa = document.getElementById('btn-psicologa');
  const inputUser = document.getElementById('username') as HTMLInputElement;
  const inputPass = document.getElementById('password') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('toggle-password');
  const eyeIcon = document.getElementById('eye-icon');
  const loginForm = document.getElementById('login-form');
  const subtitle = document.getElementById('login-subtitle');

  let currentRole = 'estudiante';

  // 1. Lógica del ojo para mostrar/ocultar contraseña
  togglePasswordBtn?.addEventListener('click', () => {
    if (inputPass.type === 'password') {
      inputPass.type = 'text';
      eyeIcon?.classList.remove('fa-eye');
      eyeIcon?.classList.add('fa-eye-slash');
    } else {
      inputPass.type = 'password';
      eyeIcon?.classList.remove('fa-eye-slash');
      eyeIcon?.classList.add('fa-eye');
    }
  });

  // 2. Cambio entre roles (Estudiante / Psicóloga)
  btnEstudiante?.addEventListener('click', () => {
    currentRole = 'estudiante';
    btnEstudiante.classList.add('active');
    btnPsicologa?.classList.remove('active');
    if (subtitle) subtitle.textContent = 'Accede a tu cuenta de estudiante para continuar';
    if (inputUser) inputUser.placeholder = 'rider.espinoza';
    if (inputPass) inputPass.placeholder = 'Número de cédula';
  });

  btnPsicologa?.addEventListener('click', () => {
    currentRole = 'psicologa';
    btnPsicologa.classList.add('active');
    btnEstudiante?.classList.remove('active');
    if (subtitle) subtitle.textContent = 'Accede con tu ID institucional de psicóloga';
    if (inputUser) inputUser.placeholder = 'ID Único (Ej: PSIC-2026)';
    if (inputPass) inputPass.placeholder = 'Contraseña institucional';
  });

  // 3. Lógica del botón "Entrar" para ingresar a la plataforma
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    if (inputUser.value.trim() === '' || inputPass.value.trim() === '') {
      alert('Por favor, completa todos los campos.');
      return;
    }

    const loginWrapper = document.getElementById('view-login-wrapper');
    const appWrapper = document.getElementById('app');
    const psychDashboard = document.getElementById('view-psych-dashboard');
    const studentDashboard = document.getElementById('view-student-dashboard');

    // Ocultar la pantalla de Login
    if (loginWrapper) {
      loginWrapper.style.setProperty('display', 'none', 'important');
    }

    // Mostrar el layout principal (#app)
    if (appWrapper) {
      appWrapper.style.setProperty('display', 'flex', 'important');
      appWrapper.classList.remove('hidden');
    }

    // Redirección según el rol seleccionado
    if (currentRole === 'psicologa') {
      if (studentDashboard) studentDashboard.classList.add('hidden');
      if (psychDashboard) psychDashboard.classList.remove('hidden');
    } else {
      if (psychDashboard) psychDashboard.classList.add('hidden');
      if (studentDashboard) studentDashboard.classList.remove('hidden');
    }
  });
</script>