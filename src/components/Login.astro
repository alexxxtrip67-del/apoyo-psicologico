---
// src/components/Login.astro
---
<div id="view-login-wrapper" style="display: flex; width: 100vw; height: 100vh; background-color: #f8fafc; align-items: center; justify-content: center;">
  <div style="display: flex; width: 900px; background: white; border-radius: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.08); overflow: hidden; border: 1px solid #e2e8f0;">
    
    <!-- Columna Izquierda: Formulario -->
    <div style="flex: 1; padding: 3rem; display: flex; flex-direction: column; justify-content: center;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
        <div style="background: rgba(99, 102, 241, 0.1); padding: 0.5rem; border-radius: 0.75rem;">
          <i class="fa-solid fa-brain" style="color: #4f46e5; font-size: 1.5rem;"></i>
        </div>
        <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0;">Apoyo Psicológico</h2>
      </div>

      <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Bienvenido/a</h3>
      <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 2rem;">Ingresa tus credenciales institucionales para continuar.</p>

      <form id="login-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">Usuario o Correo</label>
          <input type="text" id="login-user" placeholder="ej. nombre.apellido o psicologa" required style="width: 100%; padding: 0.8rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 0.95rem;" />
        </div>

        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.4rem;">Contraseña (Cédula)</label>
          <div style="position: relative;">
            <input type="password" id="login-pass" placeholder="Número de cédula" required style="width: 100%; padding: 0.8rem 2.5rem 0.8rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 0.95rem;" />
            <button type="button" id="toggle-password" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #64748b;">
              <i class="fa-solid fa-eye" id="eye-icon"></i>
            </button>
          </div>
        </div>

        <button type="submit" style="background: #4f46e5; color: white; border: none; padding: 0.9rem; border-radius: 0.75rem; font-weight: 600; font-size: 1rem; cursor: pointer; margin-top: 0.5rem; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);">
          Iniciar sesión
        </button>
      </form>
    </div>

    <!-- Columna Derecha: Ilustración / Banner -->
    <div style="flex: 1; background: linear-gradient(135deg, #0b132b 0%, #1c2541 100%); padding: 3rem; display: flex; flex-direction: column; justify-content: center; color: white; text-align: center;">
      <div style="font-size: 3.5rem; color: #818cf8; margin-bottom: 1.5rem;"><i class="fa-solid fa-shield-heart"></i></div>
      <h3 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem;">Espacio Seguro e Institucional</h3>
      <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6;">Plataforma de bienestar emocional para el acompañamiento y seguimiento académico y psicológico.</p>
    </div>

  </div>
</div>

<script>
  // Alternar visibilidad de contraseña
  const togglePassBtn = document.getElementById('toggle-password');
  const passInput = document.getElementById('login-pass') as HTMLInputElement;
  const eyeIcon = document.getElementById('eye-icon');

  togglePassBtn?.addEventListener('click', () => {
    if (passInput.type === 'password') {
      passInput.type = 'text';
      eyeIcon?.classList.remove('fa-eye');
      eyeIcon?.classList.add('fa-eye-slash');
    } else {
      passInput.type = 'password';
      eyeIcon?.classList.remove('fa-eye-slash');
      eyeIcon?.classList.add('fa-eye');
    }
  });

  // Manejar inicio de sesión diferenciado (Estudiante vs Psicóloga)
  const loginForm = document.getElementById('login-form');
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const userInput = (document.getElementById('login-user') as HTMLInputElement).value.trim().toLowerCase();

    const loginWrapper = document.getElementById('view-login-wrapper');
    if (loginWrapper) loginWrapper.style.setProperty('display', 'none', 'important');

    // Verificar si es psicóloga (si el usuario incluye 'psico', 'laura' o 'psicologa')
    if (userInput.includes('psico') || userInput.includes('laura') || userInput.includes('psicologa')) {
      const psychApp = document.getElementById('psych-app');
      if (psychApp) psychApp.style.setProperty('display', 'flex', 'important');
    } else {
      // Caso estudiante: extraer primer nombre para saludo dinámico
      const studentApp = document.getElementById('app');
      if (studentApp) studentApp.style.setProperty('display', 'flex', 'important');

      let firstName = "Estudiante";
      if (userInput.includes('.')) {
        const parts = userInput.split('.');
        firstName = parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
      } else if (userInput.length > 0) {
        firstName = userInput.charAt(0).toUpperCase() + userInput.slice(1);
      }

      const welcomeTitle = document.getElementById('welcome-title');
      const headerName = document.getElementById('header-name');
      const headerAvatar = document.getElementById('header-avatar');
      const profileNameInput = document.getElementById('profile-name-input') as HTMLInputElement;
      const profileAvatarLarge = document.getElementById('profile-avatar-large');

      if (welcomeTitle) welcomeTitle.textContent = `Hola, ${firstName} 👋`;
      if (headerName) headerName.textContent = firstName + " Pérez";
      if (headerAvatar) headerAvatar.textContent = firstName.substring(0, 2).toUpperCase();
      if (profileNameInput) profileNameInput.value = firstName + " Pérez";
      if (profileAvatarLarge) profileAvatarLarge.textContent = firstName.substring(0, 2).toUpperCase();
    }
  });
</script>