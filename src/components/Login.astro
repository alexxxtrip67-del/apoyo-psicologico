---
// src/components/Login.astro
---
<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #f8fafc; padding: 2rem; box-sizing: border-box;">
  <div style="background: white; padding: 3rem; border-radius: 1.5rem; border: 1px solid #e2e8f0; width: 100%; max-width: 480px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); box-sizing: border-box;">
    
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <div style="width: 64px; height: 64px; background: rgba(79, 70, 229, 0.1); border-radius: 1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
        <i class="fa-solid fa-shield-heart" style="color: #4f46e5; font-size: 2rem;"></i>
      </div>
      <h1 style="font-size: 1.75rem; font-weight: 800; color: #0f172a; margin: 0 0 0.5rem 0;">Espacio Seguro</h1>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0;">Accede a tu cuenta para continuar</p>
    </div>

    <form id="login-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div>
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.5rem;">Selecciona tu Rol</label>
        <select id="role-select" style="width: 100%; padding: 0.85rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; background: #f8fafc; font-size: 1rem; color: #0f172a; box-sizing: border-box;">
          <option value="estudiante">Estudiante</option>
          <option value="psicologa">Psicóloga / Profesional</option>
        </select>
      </div>

      <div>
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.5rem;">Nombre de Usuario / Correo</label>
        <input type="text" id="username-input" placeholder="Ej. Natalia" required style="width: 100%; padding: 0.85rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 1rem; color: #0f172a; box-sizing: border-box;" />
      </div>

      <div id="password-field-container">
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.5rem;">Contraseña</label>
        <div style="position: relative; display: flex; align-items: center; width: 100%; box-sizing: border-box;">
          <input type="password" id="password-input" placeholder="••••••••" style="width: 100%; padding: 0.85rem 3rem 0.85rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 1rem; color: #0f172a; box-sizing: border-box;" />
          <i id="toggle-password" class="fa-solid fa-eye" style="position: absolute; right: 1rem; color: #64748b; cursor: pointer; font-size: 1.1rem;"></i>
        </div>
      </div>

      <!-- Campo exclusivo para el código de acceso de la psicóloga -->
      <div id="psych-code-container" style="display: none;">
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.5rem;">Código Único Profesional</label>
        <input type="password" id="psych-code-input" placeholder="Ingresa el código secreto" style="width: 100%; padding: 0.85rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 1rem; color: #0f172a; box-sizing: border-box;" />
        <span style="font-size: 0.75rem; color: #64748b; margin-top: 0.4rem; display: block;">Código requerido: PSICO2026</span>
      </div>

      <button type="submit" style="background: #4f46e5; color: white; border: none; padding: 0.95rem; border-radius: 0.75rem; font-weight: 600; font-size: 1rem; cursor: pointer; margin-top: 0.5rem; width: 100%; transition: background 0.2s; box-sizing: border-box;">
        Iniciar Sesión
      </button>
    </form>
  </div>
</div>

<script>
  const roleSelect = document.getElementById('role-select') as HTMLSelectElement;
  const psychCodeContainer = document.getElementById('psych-code-container');
  const passwordContainer = document.getElementById('password-field-container');
  const togglePassword = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const loginForm = document.getElementById('login-form');

  roleSelect?.addEventListener('change', () => {
    if (roleSelect.value === 'psicologa') {
      if (psychCodeContainer) psychCodeContainer.style.display = 'block';
      if (passwordContainer) passwordContainer.style.display = 'none';
    } else {
      if (psychCodeContainer) psychCodeContainer.style.display = 'none';
      if (passwordContainer) passwordContainer.style.display = 'block';
    }
  });

  togglePassword?.addEventListener('click', () => {
    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
    passwordInput.setAttribute('type', type);
    togglePassword.className = type === 'password' ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
  });

  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const role = roleSelect.value;
    const usernameInput = (document.getElementById('username-input') as HTMLInputElement).value.trim();

    sessionStorage.clear();

    if (role === 'psicologa') {
      const psychCode = (document.getElementById('psych-code-input') as HTMLInputElement).value.trim();
      if (psychCode !== 'PSICO2026') {
        alert('Código único incorrecto. Solo la Dra. Laura Gómez puede acceder al panel profesional.');
        return;
      }
      sessionStorage.setItem('user_role', 'psicologa');
      sessionStorage.setItem('psych_user', usernameInput || 'Dra. Laura Gómez');
      window.location.href = '/psicologa';
    } else {
      if (!usernameInput) {
        alert('Por favor ingresa tu nombre de usuario.');
        return;
      }
      sessionStorage.setItem('user_role', 'estudiante');
      sessionStorage.setItem('student_user', usernameInput);
      window.location.href = '/estudiante';
    }
  });
</script>