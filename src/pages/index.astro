---
// src/pages/index.astro
import Login from '../components/Login.astro';
import StudentDashboard from '../components/StudentDashboard.astro';
import PsychDashboard from '../components/PsychDashboard.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Apoyo Psicológico - Tu bienestar también importa</title>
		<!-- FontAwesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: system-ui, -apple-system, sans-serif;">
		
		<!-- 1. LOGIN -->
		<Login />

		<!-- 2. ESTUDIANTE -->
		<div id="app" style="display: none; width: 100vw; min-height: 100vh; background-color: #f8fafc;">
			<div style="display: flex; width: 100%; min-height: 100vh;">
				<Sidebar />
				<div style="flex: 1; display: flex; flex-direction: column; min-height: 100vh; background-color: #f8fafc; overflow-y: auto;">
					<Header />
					<main style="padding: 2rem 2.5rem; flex: 1;">
						<StudentDashboard />
					</main>
				</div>
			</div>
		</div>

		<!-- 3. PSICÓLOGA -->
		<PsychDashboard />

		<script>
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				if (target.closest('#logout-btn') || target.closest('#psych-logout-btn')) {
					const loginWrapper = document.getElementById('view-login-wrapper');
					const appWrapper = document.getElementById('app');
					const psychWrapper = document.getElementById('psych-app');

					if (loginWrapper) loginWrapper.style.display = 'flex';
					if (appWrapper) appWrapper.style.display = 'none';
					if (psychWrapper) psychWrapper.style.display = 'none';
				}
			});
		</script>
	</body>
</html>