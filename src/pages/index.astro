---
// src/pages/index.astro
import Login from '../components/Login.astro';
import StudentDashboard from '../components/StudentDashboard.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Apoyo Psicológico - Tu bienestar también importa</title>
		<!-- FontAwesome para los íconos -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body>
		<!-- 1. VISTA DE INICIO DE SESIÓN -->
		<Login />

		<!-- 2. VISTA PRINCIPAL DEL SISTEMA (Oculta por defecto hasta iniciar sesión) -->
		<div id="app" class="hidden">
			<!-- Barra lateral izquierda -->
			<Sidebar />

			<!-- Contenido principal a la derecha -->
			<div class="main-content-wrapper">
				<Header />
				
				<main>
					<StudentDashboard />
				</main>
			</div>
		</div>

		<style>
			/* Asegurar que la estructura principal ocupe toda la pantalla de forma ordenada */
			#app {
				display: none; /* Se muestra con JS al hacer login */
				min-height: 100vh;
				width: 100%;
				background-color: #f8fafc;
			}

			.main-content-wrapper {
				flex: 1;
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				background-color: #f8fafc;
				overflow-y: auto;
			}

			main {
				padding: 2rem 2.5rem;
				flex: 1;
			}
		</style>
	</body>
</html>