---
// src/pages/psicologa.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Profesional - Apoyo Psicológico</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  <body style="margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #f8fafc; display: flex; height: 100vh; overflow: hidden;">

    <aside style="width: 260px; background: #0f172a; color: white; display: flex; flex-direction: column; justify-content: space-between; padding: 2rem 1.5rem; flex-shrink: 0; box-sizing: border-box;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2.5rem;">
          <div style="width: 40px; height: 40px; background: #4f46e5; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <i class="fa-solid fa-shield-heart" style="color: white; font-size: 1.25rem;"></i>
          </div>
          <div>
            <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: white;">Apoyo Psicológico</h2>
            <p style="font-size: 0.75rem; color: #94a3b8; margin: 0;">Panel Profesional</p>
          </div>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
          <button type="button" onclick="switchPsychTab('inicio')" id="p-nav-inicio" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: #4f46e5; color: white;">
            <i class="fa-solid fa-house"></i> Inicio
          </button>
          <button type="button" onclick="switchPsychTab('estudiantes')" id="p-nav-estudiantes" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-users"></i> Estudiantes
          </button>
          <button type="button" onclick="switchPsychTab('cuestionarios')" id="p-nav-cuestionarios" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-clipboard-list"></i> Cuestionarios
          </button>
          <button type="button" onclick="switchPsychTab('alertas')" id="p-nav-alertas" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-bell"></i> Alertas
          </button>
          <button type="button" onclick="switchPsychTab('reportes')" id="p-nav-reportes" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-folder-open"></i> Reportes
          </button>
          <button type="button" onclick="switchPsychTab('configuracion')" id="p-nav-configuracion" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-gear"></i> Configuración
          </button>
        </nav>
      </div>

      <div>
        <a href="/" onclick="sessionStorage.clear()" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.95rem;">
          <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
        </a>
      </div>
    </aside>

    <main style="flex: 1; padding: 2.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: 2rem; box-sizing: border-box;">

      <div style="background: white; padding: 2rem 2.5rem; border-radius: 1.5rem; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <div>
          <h1 style="font-size: 1.8rem; font-weight: 800; color: #0f172a; margin: 0 0 0.25rem 0;">Panel de Control - Dra. Laura Gómez</h1>
          <p style="color: #64748b; font-size: 0.9rem; margin: 0;">Gestión institucional de bienestar y seguimiento estudiantil.</p>
        </div>
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div style="width: 50px; height: 50px; background: #4f46e5; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem;">LG</div>
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 1rem;">Dra. Laura Gómez</div>
            <div style="font-size: 0.8rem; color: #64748b;">Código: 2026</div>
          </div>
        </div>
      </div>

      <div id="p-view-inicio" class="psych-section" style="display: flex; flex-direction: column; gap: 2rem;">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem;">Total de estudiantes</div>
            <div style="font-size: 2rem; font-weight: 800; color: #0f172a;">1248</div>
          </div>
          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem;">Cuestionarios completados</div>
            <div style="font-size: 2rem; font-weight: 800; color: #0f172a;">1120</div>
          </div>
          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem;">Casos en seguimiento</div>
            <div style="font-size: 2rem; font-weight: 800; color: #4f46e5;">18</div>
          </div>
          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.85rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem;">Alertas activas</div>
            <div id="alerts-counter" style="font-size: 2rem; font-weight: 800; color: #ef4444;">3</div>
          </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Registrar Día y Horario Libre (Disponibilidad)</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)) 120px; gap: 1rem; align-items: end;">
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.3rem;">Fecha / Día libre</label>
              <input type="text" id="slot-date" placeholder="Ej. Lunes 16 de Noviembre" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; box-sizing: border-box;" />
            </div>
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.3rem;">Hora</label>
              <input type="text" id="slot-time" placeholder="Ej. 09:00 AM - 09:45 AM" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; box-sizing: border-box;" />
            </div>
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.3rem;">Modalidad</label>
              <input type="text" id="slot-mode" placeholder="Ej. Presencial - Cubículo 1" style="width: 100%; padding: 0.65rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; box-sizing: border-box;" />
            </div>
            <button type="button" onclick="window.addPsychSlot()" style="background: #4f46e5; color: white; border: none; padding: 0.7rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Publicar</button>
          </div>
        </div>

        <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Solicitudes y Reservaciones de Estudiantes</h3>
          <div id="psych-appointments-list" style="display: flex; flex-direction: column; gap: 1rem;"></div>
        </div>

      </div>

      <div id="p-view-estudiantes" class="psych-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Directorio de Estudiantes</h2>
      </div>
      <div id="p-view-cuestionarios" class="psych-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Cuestionarios Institucionales</h2>
      </div>
      <div id="p-view-alertas" class="psych-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Alertas Activas</h2>
        <div id="psych-alerts-container" style="display: flex; flex-direction: column; gap: 1rem;"></div>
      </div>
      <div id="p-view-reportes" class="psych-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Reportes</h2>
      </div>
      <div id="p-view-configuracion" class="psych-section" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Configuración</h2>
      </div>

    </main>
  </body>
</html>

<script>
  window.switchPsychTab = function(tabName) {
    document.querySelectorAll('.psych-section').forEach(sec => {
      sec.style.display = 'none';
    });
    document.querySelectorAll('aside nav button').forEach(btn => {
      btn.style.background = 'transparent';
      btn.style.color = '#94a3b8';
    });

    const activeBtn = document.getElementById(`p-nav-${tabName}`);
    if (activeBtn) {
      activeBtn.style.background = '#4f46e5';
      activeBtn.style.color = 'white';
    }

    const target = document.getElementById(`p-view-${tabName}`);
    if (target) {
      target.style.display = 'flex';
    }
  };

  async function renderPsychDashboard() {
    const list = document.getElementById('psych-appointments-list');
    if (!list) return;

    try {
      const res = await fetch('/api/citas');
      const data = await res.json();
      const bookings = data.bookings || [];

      if (bookings.length === 0) {
        list.innerHTML = '<p style="color: #64748b; font-size: 0.9rem;">No hay solicitudes de citas pendientes.</p>';
        return;
      }

      list.innerHTML = '';
      bookings.forEach((b) => {
        const isConfirmed = b.status === 'Confirmada';
        const card = document.createElement('div');
        card.style.cssText = "display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; background: #f8fafc;";
        card.innerHTML = `
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 1rem;">Estudiante: ${b.student}</div>
            <div style="font-size: 0.9rem; color: #4f46e5; font-weight: 600;">${b.date} - ${b.time}</div>
            <div style="font-size: 0.8rem; color: #64748b;">Modalidad: ${b.mode} | Estado: <span style="font-weight:700; color:${isConfirmed ? '#10b981' : '#f59e0b'};">${b.status || 'En espera'}</span></div>
          </div>
          ${!isConfirmed ? `<button type="button" onclick="window.confirmAppointment(${b.id})" style="background: #10b981; color: white; border: none; padding: 0.6rem 1.25rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer;">Aceptar / Confirmar</button>` : `<span style="color: #10b981; font-weight: 600;"><i class="fa-solid fa-check-circle"></i> Aceptada</span>`}
        `;
        list.appendChild(card);
      });
    } catch (e) {
      console.error("Error al sincronizar citas con el servidor");
    }
  }

  window.confirmAppointment = async function(id) {
    await fetch('/api/citas', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'confirm_booking', payload: { id } })
    });
    renderPsychDashboard();
    alert('¡Cita aceptada y confirmada al estudiante con éxito!');
  };

  window.addPsychSlot = async function() {
    const dateInput = document.getElementById('slot-date');
    const timeInput = document.getElementById('slot-time');
    const modeInput = document.getElementById('slot-mode');

    if (!dateInput.value || !timeInput.value || !modeInput.value) {
      alert('Por favor completa todos los campos del horario libre.');
      return;
    }

    const newSlot = {
      id: Date.now(),
      date: dateInput.value,
      time: timeInput.value,
      mode: modeInput.value
    };

    await fetch('/api/citas', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'add_slot', payload: newSlot })
    });

    dateInput.value = '';
    timeInput.value = '';
    modeInput.value = '';
    alert('¡Día y horario libre registrado con éxito en el servidor!');
  };

  setInterval(renderPsychDashboard, 4000);
  renderPsychDashboard();
</script>