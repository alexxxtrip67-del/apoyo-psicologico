---
// src/pages/estudiante.astro
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Estudiante - Apoyo Psicológico</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  <body style="margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #f8fafc; display: flex; height: 100vh; overflow: hidden;">

    <!-- PANEL LATERAL OSCURO -->
    <aside style="width: 260px; background: #0f172a; color: white; display: flex; flex-direction: column; justify-content: space-between; padding: 2rem 1.5rem; flex-shrink: 0; box-sizing: border-box;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2.5rem;">
          <div style="width: 40px; height: 40px; background: #4f46e5; border-radius: 0.75rem; display: flex; align-items: center; justify-content: center;">
            <i class="fa-solid fa-shield-heart" style="color: white; font-size: 1.25rem;"></i>
          </div>
          <div>
            <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: white;">Apoyo Psicológico</h2>
            <p style="font-size: 0.75rem; color: #94a3b8; margin: 0;">Tu bienestar importa</p>
          </div>
        </div>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem;">
          <button onclick="navStudent('inicio')" id="btn-student-inicio" class="nav-btn" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: #4f46e5; color: white;">
            <i class="fa-solid fa-house"></i> Inicio
          </button>
          <button onclick="navStudent('cuestionario')" id="btn-student-cuestionario" class="nav-btn" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-clipboard-list"></i> Cuestionario
          </button>
          <button onclick="navStudent('citas')" id="btn-student-citas" class="nav-btn" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-calendar-check"></i> Citas con Psicóloga
          </button>
          <button onclick="navStudent('chat')" id="btn-student-chat" class="nav-btn" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-comments"></i> Chat con IA
          </button>
          <button onclick="navStudent('reportes')" id="btn-student-reportes" class="nav-btn" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-folder-open"></i> Mis reportes
          </button>
          <button onclick="navStudent('perfil')" id="btn-student-perfil" class="nav-btn" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: none; border-radius: 0.75rem; font-weight: 600; cursor: pointer; text-align: left; width: 100%; background: transparent; color: #94a3b8;">
            <i class="fa-solid fa-user"></i> Perfil
          </button>
        </nav>
      </div>

      <div>
        <a href="/" onclick="sessionStorage.clear()" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: #94a3b8; text-decoration: none; font-size: 0.95rem;">
          <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
        </a>
      </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main style="flex: 1; padding: 2.5rem; overflow-y: auto; box-sizing: border-box;">

      <!-- VISTA INICIO -->
      <div id="view-inicio" class="student-view" style="display: flex; flex-direction: column; gap: 2rem;">
        <div style="background: linear-gradient(135deg, #e0e7ff 0%, #edf2f7 100%); padding: 2.5rem; border-radius: 1.5rem; border: 1px solid #c7d2fe; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h1 id="user-greeting" style="font-size: 2rem; font-weight: 800; color: #1e1b4b; margin: 0 0 0.5rem 0;">Hola, Estudiante 👋</h1>
            <p style="color: #312e81; font-size: 0.95rem; margin: 0 0 1.25rem 0;">Tu bienestar emocional es importante. Aquí tienes un resumen de tu progreso y herramientas de apoyo.</p>
            <button onclick="navStudent('chat')" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.25rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Ir al chat con IA &rarr;</button>
          </div>
          <div style="font-size: 4rem; color: #4f46e5; opacity: 0.75;">
            <i class="fa-solid fa-hands-holding-circle"></i>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="width: 45px; height: 45px; background: rgba(79, 70, 229, 0.1); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                <i class="fa-solid fa-clipboard-list" style="color: #4f46e5; font-size: 1.25rem;"></i>
              </div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0 0 0.4rem 0;">Cuestionario emocional</h3>
              <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 1.25rem 0;">Completa tu evaluación de 10 preguntas.</p>
            </div>
            <button onclick="navStudent('cuestionario')" style="background: #4f46e5; color: white; border: none; padding: 0.65rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Ir al cuestionario</button>
          </div>

          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="width: 45px; height: 45px; background: rgba(16, 185, 129, 0.1); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                <i class="fa-solid fa-calendar-check" style="color: #10b981; font-size: 1.25rem;"></i>
              </div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0 0 0.4rem 0;">Citas con Psicóloga</h3>
              <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 1.25rem 0;">Agenda una cita directa con la especialista.</p>
            </div>
            <button onclick="navStudent('citas')" style="background: #10b981; color: white; border: none; padding: 0.65rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Ver horarios</button>
          </div>

          <div style="background: white; padding: 1.75rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="width: 45px; height: 45px; background: rgba(59, 130, 246, 0.1); border-radius: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                <i class="fa-solid fa-comments" style="color: #3b82f6; font-size: 1.25rem;"></i>
              </div>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0 0 0.4rem 0;">Chat con IA</h3>
              <p style="color: #64748b; font-size: 0.85rem; margin: 0 0 1.25rem 0;">Conversa de forma confidencial.</p>
            </div>
            <button onclick="navStudent('chat')" style="background: #3b82f6; color: white; border: none; padding: 0.65rem 1rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Abrir chat</button>
          </div>
        </div>
      </div>

      <!-- VISTA CUESTIONARIO CON 10 PREGUNTAS -->
      <div id="view-cuestionario" class="student-view" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; flex-direction: column;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0;">Cuestionario de bienestar emocional</h2>
          <span id="question-counter" style="font-weight: 700; color: #4f46e5; font-size: 0.95rem;">Pregunta 1 de 10</span>
        </div>
        <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem;">Responde con sinceridad. No hay respuestas correctas o incorrectas.</p>
        
        <!-- BARRA DE PROGRESO -->
        <div style="width: 100%; background: #e2e8f0; height: 8px; border-radius: 99px; margin-bottom: 2rem; overflow: hidden;">
          <div id="quiz-progress-bar" style="width: 10%; background: #4f46e5; height: 100%; transition: width 0.3s ease;"></div>
        </div>

        <div style="padding: 2rem; background: #f8fafc; border-radius: 1rem; border: 1px solid #e2e8f0; margin-bottom: 1.5rem;">
          <p id="quiz-question-text" style="font-weight: 700; color: #0f172a; font-size: 1.1rem; margin-bottom: 1.25rem;"></p>
          <div id="quiz-options-container" style="display: flex; flex-direction: column; gap: 0.85rem;"></div>
        </div>
        
        <div style="display: flex; justify-content: space-between;">
          <button onclick="prevQuestion()" id="btn-prev" style="background: #e2e8f0; color: #334155; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">&larr; Anterior</button>
          <button onclick="nextQuestion()" id="btn-next" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.75rem; font-weight: 600; cursor: pointer;">Siguiente &rarr;</button>
        </div>
      </div>

      <!-- VISTA CITAS DISPONIBLES Y SOLICITADAS -->
      <div id="view-citas" class="student-view" style="display: none; display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
        <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Horarios Libres Publicados por la Psicóloga</h3>
          <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem;">Selecciona una hora para reservar tu cita institucional.</p>
          <div id="student-slots-list" style="display: flex; flex-direction: column; gap: 1rem;"></div>
        </div>
        <div style="background: white; padding: 2rem; border-radius: 1.25rem; border: 1px solid #e2e8f0;">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Mis Citas Solicitadas</h3>
          <div id="my-appointments" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <p style="color: #64748b; font-size: 0.85rem;">Aún no has solicitado citas.</p>
          </div>
        </div>
      </div>

      <!-- VISTA CHAT DE IA -->
      <div id="view-chat" class="student-view" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; height: 520px; flex-direction: column; justify-content: space-between;">
        <div>
          <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">Chat con IA</h2>
          <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">Aquí puedes hablar libremente. Estoy para escucharte.</p>
        </div>
        <div id="chat-box" style="flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem; overflow-y: auto; margin-bottom: 1rem; display: flex; flex-direction: column; gap: 1rem;">
          <div style="background: white; padding: 0.85rem 1rem; border-radius: 0.75rem; border: 1px solid #e2e8f0; width: fit-content; max-width: 80%; font-size: 0.9rem; color: #1e293b;">
            Hola, soy tu asistente virtual de apoyo psicológico. ¿Cómo te sientes el día de hoy?
          </div>
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <input type="text" id="chat-input" placeholder="Escribe tu mensaje..." style="flex: 1; padding: 0.75rem 1rem; border: 1px solid #cbd5e1; border-radius: 0.75rem; outline: none; font-size: 0.95rem;" />
          <button onclick="sendChatMessage()" style="background: #4f46e5; color: white; border: none; padding: 0.75rem 1.25rem; border-radius: 0.75rem; cursor: pointer; font-weight: 600;">Enviar</button>
        </div>
      </div>

      <!-- VISTA MIS REPORTES -->
      <div id="view-reportes" class="student-view" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; flex-direction: column; gap: 1.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0;">Resultados de tu cuestionario</h2>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
          <div style="background: #f8fafc; padding: 1.5rem; border-radius: 1rem; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 1.5rem;">
            <i class="fa-solid fa-face-smile" style="font-size: 3.5rem; color: #10b981;"></i>
            <div>
              <h4 style="font-size: 1.1rem; color: #0f172a; margin: 0 0 0.5rem 0;">Tu estado emocional se encuentra en un rango estable.</h4>
              <p style="color: #64748b; font-size: 0.85rem; margin: 0;">Continúa con tus hábitos de autocuidado y no dudes en pedir ayuda si lo necesitas.</p>
            </div>
          </div>
          <div style="background: #f8fafc; padding: 1.5rem; border-radius: 1rem; border: 1px solid #e2e8f0;">
            <h4 style="font-size: 1rem; color: #0f172a; margin: 0 0 0.5rem 0;">Recomendaciones</h4>
            <ul style="color: #64748b; font-size: 0.85rem; padding-left: 1.2rem; margin: 0;">
              <li>Mantén una buena rutina de sueño.</li>
              <li>Realiza actividades relajantes.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- VISTA PERFIL -->
      <div id="view-perfil" class="student-view" style="display: none; background: white; padding: 2.5rem; border-radius: 1.25rem; border: 1px solid #e2e8f0; flex-direction: column; gap: 1.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0;">Mi Perfil</h2>
        <div style="display: flex; gap: 2rem; align-items: flex-start;">
          <div id="profile-avatar" style="width: 80px; height: 80px; background: #4f46e5; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: bold;">ES</div>
          <div style="flex: 1; display: flex; flex-direction: column; gap: 1rem; max-width: 450px;">
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.3rem;">Nombre completo</label>
              <input type="text" id="profile-name" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem;" />
            </div>
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.3rem;">Rol</label>
              <input type="text" value="Estudiante Institucional" disabled style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; background: #f1f5f9; color: #64748b;" />
            </div>
          </div>
        </div>
      </div>

    </main>
  </body>
</html>

<script>
  const student = sessionStorage.getItem('student_user') || 'Estudiante';
  
  const greeting = document.getElementById('user-greeting');
  if (greeting) greeting.textContent = `Hola, ${student} 👋`;

  const profileName = document.getElementById('profile-name') as HTMLInputElement;
  if (profileName) profileName.value = student;

  const avatar = document.getElementById('profile-avatar');
  if (avatar) avatar.textContent = student.substring(0, 2).toUpperCase();

  (window as any).navStudent = function(viewName: string) {
    document.querySelectorAll('.student-view').forEach(v => {
      (v as HTMLElement).style.display = 'none';
    });
    document.querySelectorAll('.nav-btn').forEach(btn => {
      (btn as HTMLElement).style.background = 'transparent';
      (btn as HTMLElement).style.color = '#94a3b8';
    });

    const activeBtn = document.getElementById(`btn-student-${viewName}`);
    if (activeBtn) {
      activeBtn.style.background = '#4f46e5';
      activeBtn.style.color = 'white';
    }

    const target = document.getElementById(`view-${viewName}`);
    if (target) {
      target.style.display = viewName === 'citas' ? 'grid' : 'flex';
    }
  };

  // 10 PREGUNTAS INTERESANTES DE BIENESTAR EMOCIONAL
  const quizQuestions = [
    { q: "¿Con qué frecuencia te sientes ansioso/a o preocupado/a?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"] },
    { q: "¿Cómo calificarías la calidad de tu sueño durante las últimas semanas?", q2: "¿Te cuesta conciliar el sueño?", options: ["Excelente", "Buena", "Regular", "Mala", "Muy mala"] },
    { q: "¿Te resulta fácil concentrarte en tus actividades académicas o cotidianas?", options: ["Siempre", "Casi siempre", "A veces", "Rara vez", "Nunca"] },
    { q: "¿Has experimentado cambios repentinos en tu estado de ánimo o irritabilidad?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Constantemente"] },
    { q: "¿Cuentas con redes de apoyo (amigos, familiares) con quienes hablar cuando lo necesitas?", options: ["Sí, totalmente", "En su mayoría", "Poco", "Casi nadie", "Nadie"] },
    { q: "¿Sientes motivación y energía para realizar tus tareas diarias?", options: ["Mucha energía", "Adecuada", "Regular", "Poca energía", "Sin energía"] },
    { q: "¿Experimentas síntomas físicos de estrés (dolores de cabeza, tensión muscular, fatiga)?", options: ["Nunca", "Rara vez", "A veces", "Frecuentemente", "Siempre"] },
    { q: "¿Disfrutas de las actividades que solían apasionarte?", options: ["Siempre", "La mayoría de veces", "A veces", "Rara vez", "Nunca"] },
    { q: "¿Te sientes abrumado/a por la cantidad de responsabilidades actuales?", options: ["Nada", "Poco", "Moderadamente", "Bastante", "Extremadamente"] },
    { q: "¿Consideras que manejas de manera adecuada la presión de los exámenes o trabajos?", options: ["Muy bien", "Bien", "Regular", "Con dificultad", "No la manejo"] }
  ];

  let currentQIndex = 0;
  const userAnswers: string[] = new Array(quizQuestions.length).fill('A veces');

  function renderQuestion() {
    const qText = document.getElementById('quiz-question-text');
    const optionsContainer = document.getElementById('quiz-options-container');
    const counter = document.getElementById('question-counter');
    const progressBar = document.getElementById('quiz-progress-bar');
    const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
    const btnNext = document.getElementById('btn-next') as HTMLButtonElement;

    if (!qText || !optionsContainer || !counter || !progressBar) return;

    const currentItem = quizQuestions[currentQIndex];
    qText.textContent = `${currentQIndex + 1}. ${currentItem.q}`;
    counter.textContent = `Pregunta ${currentQIndex + 1} de ${quizQuestions.length}`;
    progressBar.style.width = `${((currentQIndex + 1) / quizQuestions.length) * 100}%`;

    if (btnPrev) btnPrev.style.display = currentQIndex === 0 ? 'none' : 'block';
    if (btnNext) btnNext.textContent = currentQIndex === quizQuestions.length - 1 ? 'Finalizar cuestionario' : 'Siguiente →';

    optionsContainer.innerHTML = '';
    currentItem.options.forEach((opt) => {
      const isChecked = userAnswers[currentQIndex] === opt ? 'checked' : '';
      const label = document.createElement('label');
      label.style.cssText = "display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.5rem 0; font-size: 0.95rem; color: #1e293b;";
      label.innerHTML = `
        <input type="radio" name="quiz_opt" value="${opt}" ${isChecked} style="accent-color: #4f46e5; width: 18px; height: 18px;" />
        ${opt}
      `;
      label.querySelector('input')?.addEventListener('change', () => {
        userAnswers[currentQIndex] = opt;
      });
      optionsContainer.appendChild(label);
    });
  }

  (window as any).nextQuestion = function() {
    if (currentQIndex < quizQuestions.length - 1) {
      currentQIndex++;
      renderQuestion();
    } else {
      alert('¡Cuestionario completado con éxito! Tus resultados han sido guardados y reportados.');
      
      // Guardar alerta o reporte para la psicóloga
      let reports = JSON.parse(localStorage.getItem('psych_alerts') || '[]');
      reports.unshift({
        id: Date.now(),
        student: student,
        reason: 'Cuestionario emocional completado - Rango Estable',
        date: new Date().toLocaleDateString()
      });
      localStorage.setItem('psych_alerts', JSON.stringify(reports));

      (window as any).navStudent('reportes');
    }
  };

  (window as any).prevQuestion = function() {
    if (currentQIndex > 0) {
      currentQIndex--;
      renderQuestion();
    }
  };

  renderQuestion();

  (window as any).sendChatMessage = function() {
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const box = document.getElementById('chat-box');
    if (!input || !input.value.trim() || !box) return;

    const userMsg = document.createElement('div');
    userMsg.style.cssText = "background: #4f46e5; color: white; padding: 0.85rem 1rem; border-radius: 0.75rem; width: fit-content; max-width: 80%; align-self: flex-end; font-size: 0.9rem;";
    userMsg.textContent = input.value;
    box.appendChild(userMsg);

    input.value = '';

    setTimeout(() => {
      const reply = document.createElement('div');
      reply.style.cssText = "background: white; padding: 0.85rem 1rem; border-radius: 0.75rem; border: 1px solid #e2e8f0; width: fit-content; max-width: 80%; font-size: 0.9rem; color: #1e293b;";
      reply.textContent = "Te entiendo perfectamente. Estoy aquí para acompañarte en tu proceso.";
      box.appendChild(reply);
      box.scrollTop = box.scrollHeight;
    }, 600);
  };

  function renderStudentSlots() {
    const container = document.getElementById('student-slots-list');
    if (!container) return;

    let slots = JSON.parse(localStorage.getItem('psych_slots') || '[]');
    if (slots.length === 0) {
      slots = [
        { id: 101, date: "Martes 10 de Noviembre", time: "10:00 AM - 10:45 AM", mode: "Presencial - Cubículo 2" },
        { id: 102, date: "Jueves 12 de Noviembre", time: "03:00 PM - 03:45 PM", mode: "Virtual - Zoom" }
      ];
      localStorage.setItem('psych_slots', JSON.stringify(slots));
    }

    container.innerHTML = '';
    slots.forEach((s: any) => {
      const div = document.createElement('div');
      div.style.cssText = "display: flex; justify-content: space-between; align-items: center; padding: 1rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; background: #f8fafc;";
      div.innerHTML = `
        <div>
          <div style="font-weight: 700; color: #0f172a; font-size: 0.9rem;">${s.date}</div>
          <div style="font-size: 0.85rem; color: #4f46e5; font-weight: 600;">${s.time}</div>
          <div style="font-size: 0.75rem; color: #64748b;">Modalidad: ${s.mode}</div>
        </div>
        <button onclick="bookAppointment(${s.id})" style="background: #10b981; color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Solicitar Cita</button>
      `;
      container.appendChild(div);
    });
  }

  (window as any).bookAppointment = function(id: number) {
    let slots = JSON.parse(localStorage.getItem('psych_slots') || '[]');
    const idx = slots.findIndex((s: any) => s.id === id);
    if (idx !== -1) {
      const slot = slots[idx];
      let bookings = JSON.parse(localStorage.getItem('psych_booked_appointments') || '[]');
      bookings.unshift({
        id: Date.now(),
        student: student,
        date: slot.date,
        time: slot.time,
        mode: slot.mode,
        status: 'En espera'
      });
      localStorage.setItem('psych_booked_appointments', JSON.stringify(bookings));
      renderMyAppointments();
      alert('¡Cita solicitada! Quedó en estado "En espera" para confirmación de la psicóloga.');
    }
  };

  function renderMyAppointments() {
    const box = document.getElementById('my-appointments');
    if (!box) return;

    let bookings = JSON.parse(localStorage.getItem('psych_booked_appointments') || '[]');
    const myBookings = bookings.filter((b: any) => b.student === student);

    if (myBookings.length === 0) {
      box.innerHTML = '<p style="color: #64748b; font-size: 0.85rem;">Aún no has solicitado citas.</p>';
      return;
    }

    box.innerHTML = '';
    myBookings.forEach((b: any) => {
      const isConfirmed = b.status === 'Confirmada';
      const item = document.createElement('div');
      item.style.cssText = `padding: 0.85rem; background: ${isConfirmed ? '#d1fae5' : '#fef3c7'}; border: 1px solid ${isConfirmed ? '#10b981' : '#f59e0b'}; border-radius: 0.75rem; margin-bottom: 0.5rem;`;
      item.innerHTML = `
        <div style="font-weight: 700; font-size: 0.85rem;">${b.date}</div>
        <div style="font-size: 0.8rem; color: #4f46e5; font-weight: 600;">${b.time}</div>
        <div style="font-size: 0.75rem; color: #334155;">Estado: <span style="font-weight:700; color:${isConfirmed ? '#065f46' : '#b45309'};">${b.status || 'En espera'}</span></div>
      `;
      box.appendChild(item);
    });
  }

  renderStudentSlots();
  renderMyAppointments();
</script>