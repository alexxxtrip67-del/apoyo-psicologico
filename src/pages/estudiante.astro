---
// src/pages/estudiante.astro
import StudentDashboard from '../components/StudentDashboard.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Panel de Estudiante - Apoyo Psicológico</title>
		<!-- FontAwesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
	</head>
	<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: system-ui, -apple-system, sans-serif;">
		<div style="display: flex; width: 100vw; min-height: 100vh; background-color: #f8fafc;">
			<Sidebar />
			<div style="flex: 1; display: flex; flex-direction: column; min-height: 100vh; background-color: #f8fafc; overflow-y: auto;">
				<Header />
				<main style="padding: 2rem 2.5rem; flex: 1;">
					<StudentDashboard />
				</main>
			</div>
		</div>

		<script>
			const storedUser = sessionStorage.getItem('student_user');
			if (storedUser) {
				let firstName = "Estudiante";
				if (storedUser.includes('.')) {
					const parts = storedUser.split('.');
					firstName = parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
				} else if (storedUser.length > 0) {
					firstName = storedUser.charAt(0).toUpperCase() + storedUser.slice(1);
				}
				const welcomeTitle = document.getElementById('welcome-title');
				const headerName = document.getElementById('header-name');
				const headerAvatar = document.getElementById('header-avatar');
				const profileNameInput = document.getElementById('profile-name-input') as HTMLInputElement;
				const profileAvatarLarge = document.getElementById('profile-avatar-large');

				if (welcomeTitle) welcomeTitle.textContent = `Hola, ${firstName} 👋`;
				if (headerName) headerName.textContent = firstName + " Pérez";
				if (headerAvatar) headerAvatar.textContent = firstName.substring(0, 2).toUpperCase();
				if (profileNameInput) profileNameInput.value = firstName + " Pérez";
				if (profileAvatarLarge) profileAvatarLarge.textContent = firstName.substring(0, 2).toUpperCase();
			}

			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				if (target.closest('#logout-btn')) {
					sessionStorage.removeItem('student_user');
					window.location.href = '/';
				}
			});
		</script>
	</body>
</html>